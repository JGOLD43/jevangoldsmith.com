<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/jgold_widget_background">
  <TextView android:id="@+id/jgold_open" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:paddingHorizontal="18dp" android:text="J.GOLD  →" android:textColor="#FFD91A" android:textStyle="bold" android:textSize="23sp" android:background="@drawable/jgold_widget_button" android:contentDescription="Open JGOLD" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp" android:orientation="horizontal">
    <TextView android:id="@+id/jgold_home" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:gravity="center" android:text="Home" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/jgold_widget_button" android:contentDescription="Open JGOLD Home" />
    <TextView android:id="@+id/jgold_library" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:gravity="center" android:text="Library" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/jgold_widget_button" android:contentDescription="Open JGOLD Library" />
    <TextView android:id="@+id/jgold_studio" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:gravity="center" android:text="Studio" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/jgold_widget_button" android:contentDescription="Open JGOLD Studio" />
    <TextView android:id="@+id/jgold_site" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:gravity="center" android:text="Site" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/jgold_widget_button" android:contentDescription="Open JGOLD Site" />
  </LinearLayout>
</LinearLayout>

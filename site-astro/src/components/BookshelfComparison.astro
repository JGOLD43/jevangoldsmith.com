---
// Comparison is calculated at build time from verified, committed public
// shelf snapshots. The list builder persists named lists in localStorage.

interface BookLite {
  title?: string | null;
  author?: string | null;
  rating?: number | null;
  read?: boolean | null;
  isbn?: string | null;
}
interface ShelfBook { title: string; author?: string; }
interface ShelfSource {
  id: string;
  personId: string;
  personName: string;
  sourceName: string;
  sourceUrl: string;
  verifiedAt: string;
  bookCount: number;
  books: ShelfBook[];
}
interface PersonLite { id: string; name: string; }
interface Props { books: BookLite[]; sources: ShelfSource[]; people?: PersonLite[]; }

const { books, sources, people = [] } = Astro.props as Props;
const normaliseTitle = (value: string) => value
  .toLocaleLowerCase()
  .normalize('NFKD')
  .replace(/[\u0300-\u036f]/g, '')
  .replace(/[^a-z0-9]+/g, ' ')
  .trim();

const collectionBooks = (books || []).filter((book) => book.title);
const collectionByTitle = new Map(collectionBooks.map((book) => [normaliseTitle(book.title || ''), book]));
const comparisons = (sources || []).map((source) => {
  const sharedReads: BookLite[] = [];
  const alreadyQueued: BookLite[] = [];
  const discoveries: ShelfBook[] = [];

  source.books.forEach((shelfBook) => {
    const localBook = collectionByTitle.get(normaliseTitle(shelfBook.title));
    if (!localBook) discoveries.push(shelfBook);
    else if (localBook.read === false) alreadyQueued.push(localBook);
    else sharedReads.push(localBook);
  });

  return { source, sharedReads, alreadyQueued, discoveries };
});
const sourcePersonIds = new Set(comparisons.map(({ source }) => source.personId));
const unverifiedPeople = people.filter((person) => !sourcePersonIds.has(person.id));
---

{comparisons.length ? (
  <section class="bookshelf-tool" data-bookshelf-tool>
    <header class="bookshelf-directory">
      <div>
        <p class="bookshelf-comparison-eyebrow">Compare public shelves</p>
        <h3>Find your overlap. Build what comes next.</h3>
        <p class="bookshelf-directory-copy">Compare completed reads and your existing queue, then save new discoveries into named reading lists.</p>
      </div>
      <div class="bookshelf-directory-links" role="tablist" aria-label="Public bookshelf">
        {comparisons.map(({ source }, index) => (
          <button
            type="button"
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`shelf-${source.id}`}
            data-bookshelf-switch={source.id}
          >{source.personName}</button>
        ))}
      </div>
      {unverifiedPeople.length > 0 && (
        <details class="bookshelf-unverified">
          <summary>{unverifiedPeople.length} more people do not have a verified public shelf yet</summary>
          <p>{unverifiedPeople.map((person) => person.name).join(' · ')}</p>
        </details>
      )}
    </header>

    {comparisons.map(({ source, sharedReads, alreadyQueued, discoveries }, index) => (
      <article
        id={`shelf-${source.id}`}
        class="bookshelf-comparison"
        data-bookshelf-source={source.id}
        role="tabpanel"
        hidden={index !== 0}
      >
        <div class="bookshelf-comparison-intro">
          <div>
            <p class="bookshelf-comparison-eyebrow">Verified {source.sourceName} shelf</p>
            <h3>{source.personName}'s reading map</h3>
            <p>{source.bookCount.toLocaleString()} books · checked {source.verifiedAt} · <a href={source.sourceUrl} target="_blank" rel="noreferrer">view original source ↗</a></p>
          </div>
          <a class="bookshelf-person-link" href={`/people/${source.personId}.html`}>View person</a>
        </div>

        <div class="bookshelf-summary-strip" aria-label={`Comparison with ${source.personName}`}>
          <div><strong>{sharedReads.length}</strong><span>Read by you</span></div>
          <div><strong>{alreadyQueued.length}</strong><span>Already to read</span></div>
          <div><strong>{discoveries.length}</strong><span>New discoveries</span></div>
        </div>

        <div class="bookshelf-overlap-grid">
          <section class="bookshelf-overlap-card">
            <div class="bookshelf-section-heading">
              <div><p class="bookshelf-comparison-eyebrow">Completed overlap</p><h4>Books you've read</h4></div>
              <span>{sharedReads.length}</span>
            </div>
            {sharedReads.length ? (
              <ul class="bookshelf-match-list">
                {sharedReads.slice(0, 6).map((book) => (
                  <li>
                    <div>
                      {book.isbn ? <a href={`/books/${book.isbn}.html`}>{book.title}</a> : <span>{book.title}</span>}
                      {book.author && <small>{book.author}</small>}
                    </div>
                    {typeof book.rating === 'number' && book.rating > 0 && <span class="bookshelf-match-rating" aria-label={`${book.rating} out of 5 stars`}>{book.rating.toFixed(1)}★</span>}
                  </li>
                ))}
              </ul>
            ) : <p class="bookshelf-empty">No shared completed books yet.</p>}
            {sharedReads.length > 6 && <details class="bookshelf-more"><summary>Show {sharedReads.length - 6} more</summary><ul>{sharedReads.slice(6).map((book) => <li>{book.title}{book.author && <small>{book.author}</small>}</li>)}</ul></details>}
          </section>

          <section class="bookshelf-overlap-card bookshelf-overlap-card--queue">
            <div class="bookshelf-section-heading">
              <div><p class="bookshelf-comparison-eyebrow">Future overlap</p><h4>Already on your to-read shelf</h4></div>
              <span>{alreadyQueued.length}</span>
            </div>
            {alreadyQueued.length ? (
              <ul class="bookshelf-match-list">
                {alreadyQueued.slice(0, 6).map((book) => (
                  <li><div>{book.isbn ? <a href={`/books/${book.isbn}.html`}>{book.title}</a> : <span>{book.title}</span>}{book.author && <small>{book.author}</small>}</div><span class="bookshelf-queued-mark">Queued</span></li>
                ))}
              </ul>
            ) : <p class="bookshelf-empty">None of these are on your to-read shelf yet.</p>}
            {alreadyQueued.length > 6 && <details class="bookshelf-more"><summary>Show {alreadyQueued.length - 6} more</summary><ul>{alreadyQueued.slice(6).map((book) => <li>{book.title}{book.author && <small>{book.author}</small>}</li>)}</ul></details>}
          </section>
        </div>

        <section class="reading-list-builder" data-list-builder data-source-id={source.id} data-source-name={source.personName}>
          <div class="reading-list-builder-copy">
            <div>
              <p class="bookshelf-comparison-eyebrow">Reading-list builder</p>
              <h4>Create a list from new discoveries</h4>
              <p>Choose books that are not already in your collection. Lists are private and saved on this device.</p>
            </div>
            <div class="reading-list-fields">
              <label><span>List name</span><input type="text" maxlength="60" placeholder={`${source.personName} reading list`} data-list-name /></label>
              <button type="button" class="reading-list-save" data-save-list disabled>Save list <span data-selected-count>0</span></button>
            </div>
          </div>

          {discoveries.length ? (
            <>
              <div class="reading-list-toolbar">
                <label><span class="sr-only">Search new discoveries</span><input type="search" placeholder={`Search ${discoveries.length} new books`} data-discovery-search /></label>
                <div><button type="button" data-select-visible>Select visible</button><button type="button" data-clear-selection>Clear</button></div>
              </div>
              <div class="bookshelf-pick-list" data-discovery-list>
                {discoveries.map((book) => (
                  <button type="button" class="bookshelf-pick" aria-pressed="false" data-book-title={book.title} data-book-author={book.author || ''}>
                    <span><strong>{book.title}</strong>{book.author && <small>{book.author}</small>}</span><span class="bookshelf-pick-action" aria-hidden="true">+</span>
                  </button>
                ))}
              </div>
            </>
          ) : <p class="bookshelf-empty">Every book on this shelf is already in your collection.</p>}
          <p class="reading-list-status" data-list-status aria-live="polite"></p>
        </section>

        <section class="saved-reading-lists" aria-labelledby={`saved-lists-${source.id}`}>
          <div class="bookshelf-section-heading"><div><p class="bookshelf-comparison-eyebrow">Your lists</p><h4 id={`saved-lists-${source.id}`}>Saved reading lists</h4></div></div>
          <div data-saved-lists></div>
        </section>
      </article>
    ))}
  </section>
) : <p class="stats-empty">No public bookshelves have been verified yet.</p>}

<style is:global>
  .bookshelf-tool { color: var(--text-color); }
  .bookshelf-directory { border: 1px solid var(--border-color); background: var(--background-alt); border-radius: 12px; margin-bottom: 1rem; padding: 1rem; }
  .bookshelf-directory h3, .bookshelf-comparison h3, .bookshelf-comparison h4 { color: var(--text-color); margin: 0; font-family: Chivo, sans-serif; }
  .bookshelf-directory h3 { font-size: 1.05rem; }
  .bookshelf-directory-copy { color: var(--text-light); max-width: 48rem; margin: .3rem 0 .8rem; font-size: .82rem; line-height: 1.45; }
  .bookshelf-directory-links { flex-wrap: wrap; gap: .4rem; display: flex; }
  .bookshelf-directory-links button { border: 1px solid var(--border-color); color: var(--text-light); cursor: pointer; background: var(--background-color); border-radius: 999px; padding: .35rem .7rem; font: inherit; font-size: .78rem; font-weight: 700; }
  .bookshelf-directory-links button[aria-selected="true"] { border-color: var(--secondary-color); color: var(--text-color); box-shadow: inset 0 0 0 1px var(--secondary-color); }
  .bookshelf-unverified { color: var(--text-light); margin-top: .75rem; font-size: .74rem; }
  .bookshelf-unverified summary { cursor: pointer; }
  .bookshelf-unverified p { margin: .35rem 0 0; line-height: 1.5; }
  .bookshelf-comparison-intro { align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: .9rem; display: flex; }
  .bookshelf-comparison-eyebrow { color: var(--text-light); letter-spacing: .1em; text-transform: uppercase; margin: 0 0 .22rem; font-size: .64rem; font-weight: 800; }
  .bookshelf-comparison-intro h3 { font-size: 1.15rem; }
  .bookshelf-comparison-intro p:not(.bookshelf-comparison-eyebrow) { color: var(--text-light); margin: .3rem 0 0; font-size: .8rem; }
  .bookshelf-comparison-intro a { color: var(--secondary-color); }
  .bookshelf-person-link { border: 1px solid var(--border-color); color: var(--text-color) !important; border-radius: 999px; flex: none; padding: .35rem .7rem; font-size: .76rem; font-weight: 700; }
  .bookshelf-summary-strip { border: 1px solid var(--border-color); border-radius: 10px; grid-template-columns: repeat(3, 1fr); margin-bottom: 1rem; display: grid; overflow: hidden; }
  .bookshelf-summary-strip > div { gap: .15rem; padding: .7rem .9rem; display: flex; flex-direction: column; }
  .bookshelf-summary-strip > div + div { border-left: 1px solid var(--border-color); }
  .bookshelf-summary-strip strong { color: var(--text-color); font-size: 1.25rem; line-height: 1; }
  .bookshelf-summary-strip span { color: var(--text-light); font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; }
  .bookshelf-overlap-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; margin-bottom: .75rem; display: grid; }
  .bookshelf-overlap-card, .reading-list-builder, .saved-reading-lists { border: 1px solid var(--border-color); background: var(--background-alt); border-radius: 12px; padding: .9rem; }
  .bookshelf-overlap-card--queue { border-color: color-mix(in srgb, var(--secondary-color) 42%, var(--border-color)); }
  .bookshelf-section-heading { justify-content: space-between; align-items: center; gap: .75rem; margin-bottom: .55rem; display: flex; }
  .bookshelf-section-heading h4, .reading-list-builder h4 { font-size: .92rem; }
  .bookshelf-section-heading > span { color: var(--text-light); background: var(--background-color); border-radius: 999px; padding: .18rem .48rem; font-size: .72rem; font-weight: 700; }
  .bookshelf-match-list { margin: 0; padding: 0; list-style: none; }
  .bookshelf-match-list li { border-top: 1px solid var(--border-color); justify-content: space-between; align-items: center; gap: .75rem; padding: .48rem 0; display: flex; }
  .bookshelf-match-list a, .bookshelf-match-list li div > span { color: var(--text-color); font-size: .8rem; font-weight: 700; }
  .bookshelf-match-list small, .bookshelf-more small { color: var(--text-light); margin-top: .08rem; display: block; font-size: .7rem; }
  .bookshelf-match-rating { color: var(--secondary-color); font-size: .72rem; white-space: nowrap; }
  .bookshelf-queued-mark { color: var(--secondary-color); font-size: .66rem; font-weight: 800; text-transform: uppercase; }
  .bookshelf-empty { color: var(--text-light); margin: .5rem 0 0; font-size: .78rem; }
  .bookshelf-more { border-top: 1px solid var(--border-color); color: var(--text-light); padding-top: .5rem; font-size: .74rem; }
  .bookshelf-more summary { cursor: pointer; font-weight: 700; }
  .bookshelf-more ul { margin: .45rem 0 0; padding-left: 1rem; }
  .reading-list-builder { margin-bottom: .75rem; }
  .reading-list-builder-copy { justify-content: space-between; align-items: flex-end; gap: 1rem; margin-bottom: .7rem; display: flex; }
  .reading-list-builder-copy > div:first-child > p:last-child { color: var(--text-light); margin: .25rem 0 0; font-size: .76rem; }
  .reading-list-fields { align-items: flex-end; gap: .45rem; flex: 0 1 32rem; display: flex; }
  .reading-list-fields label { flex: 1; }
  .reading-list-fields label > span { color: var(--text-light); margin-bottom: .2rem; display: block; font-size: .66rem; font-weight: 700; text-transform: uppercase; }
  .reading-list-fields input, .reading-list-toolbar input { border: 1px solid var(--border-color); color: var(--text-color); background: var(--background-color); border-radius: 8px; width: 100%; padding: .5rem .65rem; font: inherit; font-size: .78rem; }
  .reading-list-save { border: 1px solid var(--secondary-color); color: #17120a; cursor: pointer; background: var(--secondary-color); border-radius: 8px; padding: .5rem .7rem; font: inherit; font-size: .76rem; font-weight: 800; white-space: nowrap; }
  .reading-list-save:disabled { opacity: .42; cursor: not-allowed; }
  .reading-list-save span { background: #ffffff52; border-radius: 999px; margin-left: .25rem; padding: .05rem .28rem; }
  .reading-list-toolbar { justify-content: space-between; gap: .75rem; margin-bottom: .5rem; display: flex; }
  .reading-list-toolbar label { width: min(22rem, 100%); }
  .reading-list-toolbar > div { gap: .35rem; display: flex; }
  .reading-list-toolbar button { border: 1px solid var(--border-color); color: var(--text-color); cursor: pointer; background: var(--background-color); border-radius: 8px; padding: .42rem .6rem; font: inherit; font-size: .72rem; font-weight: 700; }
  .bookshelf-pick-list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .35rem; max-height: 19rem; padding-right: .2rem; display: grid; overflow: auto; }
  .bookshelf-pick { border: 1px solid var(--border-color); color: var(--text-color); cursor: pointer; background: var(--background-color); border-radius: 8px; justify-content: space-between; align-items: center; gap: .65rem; min-height: 3rem; padding: .45rem .55rem; text-align: left; display: flex; }
  .bookshelf-pick:hover { border-color: var(--secondary-color); }
  .bookshelf-pick[aria-pressed="true"] { border-color: var(--secondary-color); background: color-mix(in srgb, var(--secondary-color) 12%, var(--background-color)); box-shadow: inset 0 0 0 1px var(--secondary-color); }
  .bookshelf-pick strong { font-size: .76rem; line-height: 1.25; display: block; }
  .bookshelf-pick small { color: var(--text-light); margin-top: .12rem; font-size: .68rem; display: block; }
  .bookshelf-pick-action { color: var(--text-light); font-size: 1rem; }
  .bookshelf-pick[aria-pressed="true"] .bookshelf-pick-action { color: var(--secondary-color); transform: rotate(45deg); }
  .reading-list-status { color: var(--text-light); min-height: 1em; margin: .5rem 0 0; font-size: .72rem; }
  .saved-reading-lists { background: transparent; }
  .saved-list-empty { color: var(--text-light); margin: 0; font-size: .76rem; }
  .saved-list-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .5rem; display: grid; }
  .saved-list-card { border: 1px solid var(--border-color); background: var(--background-alt); border-radius: 9px; padding: .65rem; }
  .saved-list-card header { justify-content: space-between; align-items: flex-start; gap: .5rem; display: flex; }
  .saved-list-card h5 { color: var(--text-color); margin: 0; font-size: .82rem; }
  .saved-list-card header span { color: var(--text-light); font-size: .68rem; }
  .saved-list-card button { border: 0; color: var(--text-light); cursor: pointer; background: transparent; padding: .1rem; font: inherit; font-size: .68rem; }
  .saved-list-card ul { margin: .5rem 0 0; padding: 0; list-style: none; }
  .saved-list-card li { border-top: 1px solid var(--border-color); padding: .3rem 0; font-size: .72rem; }
  .saved-list-card li small { color: var(--text-light); margin-top: .06rem; display: block; font-size: .65rem; }
  @media (max-width: 760px) {
    .bookshelf-comparison-intro, .reading-list-builder-copy { align-items: stretch; display: block; }
    .bookshelf-person-link { margin-top: .65rem; display: inline-block; }
    .bookshelf-overlap-grid, .bookshelf-pick-list, .saved-list-grid { grid-template-columns: 1fr; }
    .reading-list-fields { margin-top: .7rem; }
  }
  @media (max-width: 520px) {
    .bookshelf-summary-strip { grid-template-columns: 1fr; }
    .bookshelf-summary-strip > div { flex-direction: row; align-items: baseline; }
    .bookshelf-summary-strip > div + div { border-top: 1px solid var(--border-color); border-left: 0; }
    .reading-list-fields, .reading-list-toolbar { align-items: stretch; flex-direction: column; display: flex; }
    .reading-list-save { width: 100%; }
  }
</style>

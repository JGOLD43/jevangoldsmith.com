---
import BookYearFilter from './BookYearFilter.astro';
interface Props { years: number[]; id: string; sidebar?: boolean; }
const { years, id, sidebar = false } = Astro.props;
---
<div class:list={['books-browse-controls', { 'books-browse-controls--sidebar': sidebar }]}>
  <BookYearFilter years={years} id={id} />
  <a class="books-most-liked" href="/books-by-rating.html" data-most-liked-link>
    <svg class="ico-stroke" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-star"></use></svg>
    <span>Most Liked</span>
  </a>
</div>

<style is:global>
  .books-browse-controls {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    grid-column: 1;
    grid-row: 2;
    align-self: center;
    justify-self: start;
    width: 16rem;
    max-width: 100%;
    min-width: 0;
  }
  .books-browse-controls > * { flex: 1 1 6rem; }
  .books-most-liked {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .45rem;
    min-height: 44px;
    padding: .6rem .65rem;
    border: 1px solid color-mix(in srgb, var(--secondary-color) 40%, var(--border-color));
    border-radius: .65rem;
    background: color-mix(in srgb, var(--secondary-color) 9%, transparent);
    color: var(--text-color);
    font-size: .85rem;
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
    white-space: nowrap;
  }
  .books-most-liked svg { flex: none; color: var(--secondary-color); }
  .books-most-liked:hover {
    border-color: var(--secondary-color);
    background: color-mix(in srgb, var(--secondary-color) 18%, transparent);
  }
  .books-most-liked:focus-visible { outline: 2px solid var(--secondary-color); outline-offset: 3px; }
  .books-browse-controls--sidebar { width: calc(100% - 2rem); margin: 0 1rem 1rem; }
  .collapsed .books-browse-controls--sidebar { display: none; }
  @media (width <= 900px) {
    .mobile-list-view .collapsed .books-browse-controls--sidebar { display: flex; }
  }
  @media (width <= 400px) {
    .books-most-liked { gap: .3rem; padding-inline: .4rem; font-size: .8rem; }
    .books-most-liked svg { width: 12px; height: 12px; }
  }
</style>

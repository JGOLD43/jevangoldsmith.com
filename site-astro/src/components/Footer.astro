---
import NewsletterSignup from './NewsletterSignup.astro';
const hasInlineSignup = ['/', '/index.html', '/about', '/about.html', '/start-here', '/start-here.html', '/newsletter', '/newsletter.html', '/now', '/now.html', '/essays', '/essays.html', '/weekly-review-template', '/weekly-review-template.html'].includes(Astro.url.pathname) || /^\/(projects|updates|essays)\//.test(Astro.url.pathname);
---
<footer class="footer site-footer">
  {!hasInlineSignup && !['/products', '/products.html', '/cool-shit', '/cool-shit.html'].includes(Astro.url.pathname) && <div class="container"><NewsletterSignup id="footer-signup" source="footer" /></div>}
  <div class="container site-footer-grid">
    <div class="site-footer-brand">
      <a href="/index.html" class="site-footer-brand-link">Jevan Goldsmith</a>
      <p class="site-footer-tagline">Essays on attention, work and life. A letter once a month.</p>
      <div class="site-footer-social" aria-label="Social">
        <a href="https://x.com/JevanGoldsmith" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)">
          <svg class="ico-fill ico-20" viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-x"/></svg>
        </a>
        <a href="https://youtube.com/@JevanGoldsmith" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
          <svg class="ico-fill ico-20" viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-youtube"/></svg>
        </a>
        <a href="https://linkedin.com/in/jevan-goldsmith-7b885a185" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg class="ico-fill ico-20" viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-linkedin"/></svg>
        </a>
        <a href="https://letterboxd.com/contentwatch" target="_blank" rel="noopener noreferrer" aria-label="Letterboxd">
          <svg class="ico-fill ico-20" viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-letterboxd"/></svg>
        </a>
      </div>
    </div>
    <nav class="site-footer-col" aria-label="Writing">
      <h3 class="site-footer-col-title">Writing</h3>
      <ul>
        <li><a href="/newsletter.html">Monthly letter</a></li>
        <li><a href="/essays.html">Essays</a></li>
        <li><a href="/start-here.html">Start Here</a></li>
        <li><a href="/about.html">About</a></li>
        <li><a href="/rss.xml">RSS</a></li>
        <li><a href="/lesson-logger.html">Lesson Log</a></li>
        <li><a href="/free-resources.html">Resources</a></li>
      </ul>
    </nav>
    <nav class="site-footer-col" aria-label="Taste">
      <h3 class="site-footer-col-title">Taste</h3>
      <ul>
        <li><a href="/books.html">Reading</a></li>
        <li><a href="/movies.html">Movies</a></li>
        <li><a href="/products.html">The Shelf</a></li>
        <li><a href="/cool-shit.html">Interests</a></li>
      </ul>
    </nav>
    <nav class="site-footer-col" aria-label="Experiences">
      <h3 class="site-footer-col-title">Experiences</h3>
      <ul>
        <li><a href="/projects.html">Projects</a></li>
        <li><a href="/challenges.html">Challenges</a></li>
        <li><a href="/adventures.html">Trips</a></li>
        <li><a href="/resume.html">Resume</a></li>
      </ul>
    </nav>
  </div>
  <div class="container site-footer-bottom">
    <p>&copy; 2026 Jevan Goldsmith. All rights reserved.</p>
    <a href="/contact.html">Contact</a>
    <a href="/privacy.html">Privacy</a>
    <a href="#top" class="site-footer-back">Back to top ↑</a>
  </div>
</footer>

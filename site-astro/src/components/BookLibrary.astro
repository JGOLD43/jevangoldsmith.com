---
import type { CollectionEntry } from 'astro:content';
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import sharp from 'sharp';
import { bookCoverUrl } from '../lib/book-card';
import { ratingTier } from '../lib/rating-tier';
import InlineJson from './InlineJson.astro';

interface Props { books: CollectionEntry<'books'>[]; }
const { books } = Astro.props;
const library = await Promise.all(books
  .filter(({ data }) => data.read !== false)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, 'en', { numeric: true }))
  .map(async ({ id, data }) => {
    const cover = bookCoverUrl(data);
    let ratio = 2 / 3;
    // Use each actual cover's proportions instead of stretching every book
    // into the same rectangle. Only inspect files already in the repository.
    if (cover.startsWith('/images/')) {
      const file = resolve(process.cwd(), '..', `.${cover}`);
      if (existsSync(file)) {
        const metadata = await sharp(file).metadata();
        if (metadata.width && metadata.height) ratio = metadata.width / metadata.height;
      }
    }
    const tier = ratingTier(data.rating);
    return { id: data.isbn || id, title: data.title, author: data.author, cover, ratio,
      tier: tier?.key || '', tierLabel: tier?.label || 'Unrated', tierColor: tier?.color || '#e3d8c6',
      collection: data.category?.trim() || 'Uncollected',
      href: `/books/${encodeURIComponent(id)}.html` };
  }));
---
<section class="book-library" id="book-library" aria-label="Library view" hidden>
  <div class="book-library-room" aria-hidden="true"></div>
  <header class="book-library-header">
    <div><h2>Library</h2><p>{library.length} books read</p></div>
    <div class="book-library-header-actions">
      <details class="book-library-sort">
        <summary aria-label="Sort books" aria-controls="book-library-sort-options">
          Sort <svg class="book-library-sort-chevron" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="m3 4.5 3 3 3-3" /></svg>
        </summary>
        <div id="book-library-sort-options" class="book-library-sort-options" role="group" aria-label="Book order">
          <button type="button" data-library-sort="tiers" aria-pressed="false">By tiers <span aria-hidden="true">✓</span></button>
          <button type="button" data-library-sort="az" aria-pressed="true">A–Z <span aria-hidden="true">✓</span></button>
          <button type="button" data-library-sort="collection" aria-pressed="false">By collection <span aria-hidden="true">✓</span></button>
        </div>
      </details>
      <button type="button" class="book-library-exit" data-close-book-library>
        <span aria-hidden="true">←</span> Bookshelf
      </button>
    </div>
  </header>
  <div class="book-library-stage" tabindex="0" role="region"
    aria-label="Interactive library. Drag the shelf to browse. Move over or drag the selected book to rotate it. Double-click a book to open its details."
    aria-describedby="book-library-help">
    <div class="book-library-shelf" aria-hidden="true">
      <div class="book-library-shelf-top"><div class="book-library-wood-grain"></div></div>
      <div class="book-library-shelf-front"><div class="book-library-wood-grain"></div></div>
    </div>
    <div class="book-library-contact-shadows" aria-hidden="true"></div>
    <div class="book-library-track"></div>
  </div>
  <p id="book-library-help" class="sr-only">Move the mouse over the selected book to tilt it, or hold and drag it to rotate. Drag the shelf or use left and right arrows to browse, Home or End for the first or last book. Double-click or double-tap a book, or press Enter, to open its details. Escape returns to the bookshelf. Request opens an email about the selected book.</p>
  <div class="book-library-controls">
    <button class="book-library-arrow" type="button" data-library-step="-1" aria-label="Previous book">←</button>
    <div class="book-library-caption">
      <div aria-live="polite" aria-atomic="true">
        <p class="book-library-group" hidden></p>
        <a class="book-library-title" href={library[0]?.href || '/books.html'}>{library[0]?.title}</a>
        <p class="book-library-author">{library[0]?.author}</p>
      </div>
      <a class="book-library-request" href="mailto:hello@jevangoldsmith.com" aria-label="Request the selected book by email">request</a>
    </div>
    <button class="book-library-arrow" type="button" data-library-step="1" aria-label="Next book">→</button>
  </div>
  <p class="sr-only" data-library-sort-status role="status"></p>
  {library.length === 0 && <p class="book-library-empty">No books marked as read yet.</p>}
</section>
<InlineJson id="jg-book-library" data={library} />
<script>
  import '../scripts/book-library';
</script>
<style is:global>
  .books-view-picker { position: relative; }
  .books-view-picker > summary { list-style: none; cursor: pointer; }
  .books-view-picker > summary::-webkit-details-marker { display: none; }
  .books-view-picker > summary .view-icon-grid { display: block; }
  .books-view-menu {
    position: absolute; z-index: 90; right: 0; top: calc(100% + .5rem);
    display: grid; width: 190px; padding: .35rem; gap: .15rem;
    border: 1px solid var(--border-color); border-radius: .75rem;
    background: var(--background); box-shadow: 0 12px 32px #0003;
  }
  .books-view-picker:not([open]) > .books-view-menu { display: none; }
  .books-view-menu button {
    display: flex; align-items: center; gap: .65rem; padding: .7rem .8rem;
    min-height: 44px; border: 0; border-radius: .4rem; background: transparent;
    color: var(--text-color); font: inherit; font-size: .9rem; text-align: left; cursor: pointer;
  }
  .books-view-menu button:hover, .books-view-menu button[aria-pressed="true"] { background: var(--background-alt); }
  .books-view-menu svg { width: 18px; height: 18px; flex: none; }
  .books-view-menu small { color: var(--text-light); font-size: .7rem; margin-left: auto; }
  .book-library[hidden] { display: none !important; }
  .book-library {
    position: fixed; inset: var(--nav-height, 58px) 0 0; z-index: 900;
    overflow: hidden; background: #21170f; color: #fff;
    font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif;
    isolation: isolate;
  }
  .book-library-room {
    position: absolute; inset: -12px;
    background-image: linear-gradient(#160e0780, #160e07ad), url('/images/library/library-room.webp');
    background-size: auto 100%; background-repeat: repeat-x;
    background-position: calc(50% + var(--room-offset, 0px)) center;
    filter: blur(3px); pointer-events: none;
  }
  .book-library::after {
    content: ''; position: absolute; inset: auto 0 0; height: 180px; z-index: 2;
    background: linear-gradient(transparent, #160e08dc 72%); pointer-events: none;
  }
  html:has(body.book-library-open), body.book-library-open { overflow: hidden !important; }
  body.book-library-open .collection-mobile-toggle { visibility: hidden; }
  .book-library-header {
    position: absolute; z-index: 3; inset: 0 0 auto; padding: 1.5rem 2.5rem;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    pointer-events: none;
  }
  .book-library-header h2 { color: #fff; font: inherit; font-size: 1rem; font-weight: 500; margin: 0; }
  .book-library-header p { color: #e3d8c6; font-size: .72rem; margin: .2rem 0 0; }
  .book-library-header-actions { display: flex; align-items: center; gap: .5rem; pointer-events: auto; }
  .book-library-exit, .book-library-sort > summary {
    pointer-events: auto; display: inline-flex; align-items: center; gap: .45rem;
    color: #fff; border: 1px solid #ffffff55; background: #24190ec9; border-radius: 6px;
    min-height: 40px; padding: .5rem .75rem; font: inherit; font-size: .8rem; cursor: pointer;
  }
  .book-library-exit:hover, .book-library-sort > summary:hover { background: #ffffff15; }
  .book-library-sort { position: relative; }
  .book-library-sort > summary { list-style: none; }
  .book-library-sort > summary::-webkit-details-marker { display: none; }
  .book-library-sort-chevron {
    display: block; flex: none; width: .75rem; height: .75rem;
    fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
  }
  .book-library-sort-options {
    position: absolute; top: calc(100% + .55rem); right: 0; width: 188px;
    padding: .35rem; border: 1px solid #ffffff35; border-radius: 10px;
    background: #281e16; box-shadow: 0 14px 36px #0006;
  }
  .book-library-sort:not([open]) .book-library-sort-options { display: none; }
  .book-library-sort-options button {
    display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 44px;
    padding: .65rem .75rem; border: 0; border-radius: 6px; background: transparent;
    color: #f7f0e4; font: inherit; font-size: .8rem; text-align: left; cursor: pointer;
  }
  .book-library-sort-options button:hover, .book-library-sort-options button[aria-pressed="true"] { background: #ffffff12; }
  .book-library-sort-options button span { color: #f3d36b; visibility: hidden; }
  .book-library-sort-options button[aria-pressed="true"] span { visibility: visible; }
  .book-library-stage-outgoing { pointer-events: none; }
  .book-library-stage {
    position: absolute; inset: 80px 0 158px; perspective: 1800px;
    cursor: grab; touch-action: pinch-zoom; user-select: none; -webkit-user-select: none;
    outline-offset: -4px;
  }
  .book-library-stage[data-dragging="true"], .book-library-stage[data-rotating="true"] { cursor: grabbing; }
  .book-library-shelf {
    position: absolute; left: -50%; top: 65%; width: 200%; height: var(--shelf-depth, 130px);
    transform: skewY(-15.642deg); transform-origin: 50% 0;
    pointer-events: none; filter: drop-shadow(0 22px 16px #09050288);
  }
  .book-library-shelf-top {
    /* Extend behind the back row so the full width of each angled binding
       rests on wood, while keeping the front edge clear of the controls. */
    position: absolute; inset: calc(-1 * var(--shelf-rear-depth, 52px)) 0 0;
    overflow: hidden; background: #795335;
    border-top: 1px solid #312013; border-bottom: 2px solid #d3a2739c;
  }
  .book-library-wood-grain {
    position: absolute; inset: 0 -960px;
    background: url('/images/library/walnut-grain.webp') repeat-x 0 center / 960px 360px;
    transform: translate3d(var(--wood-offset, 0px), 0, 0); will-change: transform;
  }
  .book-library-shelf-top::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(#1c100b66, transparent 38%, #e0b5831a 86%, #fff0);
    box-shadow: inset 0 12px 14px -10px #0009;
  }
  .book-library-shelf-front {
    position: absolute; top: 100%; left: 0; right: 0; height: 22px;
    overflow: hidden; background: #4e301c; border-top: 1px solid #e4b28399;
  }
  .book-library-shelf-front .book-library-wood-grain { background-size: 960px 160px; }
  .book-library-shelf-front::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(#321c1026, #23140cb3);
    box-shadow: inset 0 -2px 2px #160c0877;
  }
  .book-library-contact-shadows { position: absolute; inset: 0; perspective: 1800px; pointer-events: none; }
  .library-volume-contact {
    position: absolute; left: 50%; top: 65%; height: 0; width: var(--width);
    transform-origin: 50% 0; transform-style: preserve-3d;
    /* Use the binding's camera, rotation, and bottom-centre anchor.
       A shelf-skewed ellipse drifts away from the actual book edge. */
    transform: translate3d(calc(-50% + var(--x)), var(--y), 0) rotateY(calc(-16deg + var(--inspect-yaw, 0deg))) rotateZ(3deg);
  }
  .library-volume-contact::before {
    /* Spread the shadow around the contact edge in the visible shelf plane.
       A 90-degree plane projects behind the cover and hides the shadow. */
    content: ''; position: absolute; left: -8%; right: -8%; top: calc(var(--depth) * -.2);
    height: calc(var(--depth) * .8);
    background: radial-gradient(ellipse at 50% 35%, #0a0603a6 0%, #0a060366 38%, #0a060300 73%);
    border-radius: 50%; filter: blur(3px);
  }
  .library-volume-contact::after {
    content: ''; position: absolute; left: 1px; right: 1px; top: -1px; height: 4px;
    background: #0a0603b3; border-radius: 50%; filter: blur(1px);
  }
  .book-library-track { position: absolute; inset: 0; perspective: 1800px; }
  .library-volume {
    position: absolute; left: 50%; top: 65%; width: var(--width); height: var(--height);
    margin: 0; padding: 0; border: 0; background: none; border-radius: 0;
    transform-style: preserve-3d; transform-origin: 50% 100%;
    transform: translate3d(calc(-50% + var(--x)), calc(-100% + var(--y)), 0) rotateY(calc(-16deg + var(--inspect-yaw, 0deg))) rotateX(var(--inspect-pitch, 0deg)) rotateZ(3deg);
    cursor: inherit; -webkit-tap-highlight-color: transparent;
  }
  .library-volume > span { position: absolute; display: block; }
  .library-volume-back {
    inset: 0; background: #283343; transform: translateZ(calc(-1 * var(--depth)));
  }
  .library-volume-spine {
    top: 0; bottom: 0; left: calc(-1 * var(--depth)); width: var(--depth); background: #283343;
    transform-origin: right center; transform: rotateY(-90deg);
  }
  .library-volume-pages {
    top: 2px; bottom: 2px; left: calc(100% - 1px); width: calc(var(--depth) - 2px);
    /* Soft paper layers stay readable after the edge is foreshortened.
       Subpixel, high-contrast stripes turn into a diagonal moiré pattern. */
    background:
      linear-gradient(90deg, #8d806b33, transparent 18%, #ffffff55 48%, transparent 78%, #82745e26),
      repeating-linear-gradient(90deg, #eeeadd 0, #f7f4eb 2px, #f7f4eb 4px, #e7e1d4 5px, #f4f0e6 7px);
    box-shadow: inset 0 1px #fff8, inset 0 -1px #8f826d33;
    transform-origin: left center; transform: rotateY(90deg);
  }
  .library-volume-top, .library-volume-bottom {
    left: 1px; right: 1px; height: calc(var(--depth) - 1px);
    transform-origin: 50% 0; transform: rotateX(-90deg);
    background: repeating-linear-gradient(0deg, #e7e1d4 0, #f7f4eb 2px, #eeeadd 4px);
    box-shadow: inset 0 0 0 1px #82745e33;
  }
  .library-volume-top { top: 1px; }
  .library-volume-bottom { top: calc(100% - 1px); }
  .library-volume-cover { inset: 0; background: #e6dfcd; overflow: hidden; }
  .library-volume-cover img { display: block; width: 100%; height: 100%; pointer-events: none; -webkit-user-drag: none; }
  .library-volume-cover::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(calc(115deg + var(--inspect-yaw, 0deg)), transparent 20%, rgb(255 255 255 / var(--inspect-shine, 0)) 50%, transparent 80%),
      linear-gradient(90deg, #0004, transparent 3%, #fff2 4%, transparent 6%, transparent 96%, #0002);
    box-shadow: inset 0 0 0 1px #0002;
  }
  .library-volume-fallback { display: flex; height: 100%; align-items: center; padding: 1rem; color: #283343; font: 600 1rem/1.3 Georgia, serif; }
  .detail-page--book .detail-hero-cover.has-book-volume {
    position: relative; overflow: visible; border-radius: 0;
    background: transparent; box-shadow: none;
  }
  .detail-page--book .has-book-volume .library-volume-cover img {
    height: 100%; border-radius: 0; background: transparent;
  }
  .book-library-controls {
    z-index: 3;
    position: absolute; bottom: max(28px, env(safe-area-inset-bottom)); left: 50%; transform: translateX(-50%);
    display: grid; grid-template-columns: 44px minmax(0, 1fr) 44px; gap: 1rem;
    align-items: center; width: min(460px, calc(100% - 32px)); text-align: center;
  }
  .book-library-caption { min-width: 0; }
  .book-library-group {
    margin: 0 0 .4rem; color: var(--tier-color, #e3d8c6); font-size: .65rem;
    line-height: 1.3; letter-spacing: .06em; text-transform: uppercase;
  }
  .book-library-title {
    color: #fff; font-size: .9rem; font-weight: 400; line-height: 1.35;
    text-transform: lowercase; text-decoration: none; display: -webkit-box;
    -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .book-library-title:hover { text-decoration: underline; }
  .book-library-author { color: #e3d8c6; font-size: .8rem; margin: .35rem 0 0; line-height: 1.4; }
  .book-library-request {
    display: flex; align-items: center; justify-content: center; width: 144px; min-height: 40px;
    margin: .9rem auto 0; background: #f7f0e4; color: #382416; border-radius: 6px;
    border: 1px solid #efe2cd; text-decoration: none; font-size: .8rem;
  }
  .book-library-request:hover { background: #eadcc5; }
  .book-library-arrow { border: 0; background: transparent; color: #fff; font: inherit; font-size: 1rem; width: 44px; height: 44px; cursor: pointer; }
  .book-library :focus-visible, .books-view-picker :focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .book-library-stage:focus, .book-library-stage:focus-visible { outline: none; box-shadow: none; }
  .book-library-empty { padding: 8rem 2rem; text-align: center; }
  @media (max-width: 600px) {
    .book-library-header { padding: 1.1rem; }
    .book-library-stage { top: 72px; bottom: 154px; }
    .book-library-controls { gap: .4rem; bottom: max(24px, env(safe-area-inset-bottom)); }
  }
  @media (max-height: 560px) {
    .book-library-header { padding-block: .6rem; }
    .book-library-stage { top: 50px; bottom: 125px; }
    .book-library-controls { bottom: 10px; }
    .book-library-request { margin-top: .45rem; }
  }
</style>

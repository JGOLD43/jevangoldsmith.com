---
interface Props { years: number[]; id: string; }
const { years, id } = Astro.props;
---
<label class="book-year-filter" for={id}>
  <span class="sr-only">Year</span>
  <span class="book-year-value">
    <select id={id} data-book-year-filter aria-label="Filter by year read">
      <option value="all" selected>All years</option>
      {years.map((year) => <option value={year}>{year}</option>)}
    </select>
    <svg class="ico-stroke" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-chevronDown"></use></svg>
  </span>
</label>

<style is:global>
  .book-year-filter {
    display: flex;
    align-items: center;
    min-height: 44px;
    min-width: 0;
    border: 1px solid var(--border-color);
    border-radius: .65rem;
    background: color-mix(in srgb, var(--background-alt) 65%, transparent);
    color: var(--text-color);
  }
  .book-year-filter:hover { border-color: var(--text-light); }
  .book-year-value { display: flex; align-items: center; position: relative; width: 100%; min-width: 0; }
  .book-year-value select {
    appearance: none;
    width: 100%;
    min-width: 0;
    min-height: 42px;
    padding: .6rem 1.8rem .6rem .75rem;
    border: 0;
    border-radius: .6rem;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: .85rem;
    font-weight: 500;
    line-height: 1.4;
    cursor: pointer;
  }
  .book-year-value select option { background: var(--background); color: var(--text-color); }
  .book-year-value svg { position: absolute; right: .65rem; color: var(--text-light); pointer-events: none; }
  .book-year-value select:focus-visible { outline: 2px solid var(--secondary-color); outline-offset: 3px; }
  @media (width <= 400px) {
    .book-year-value select { padding-inline: .55rem 1.5rem; font-size: .8rem; }
    .book-year-value svg { right: .5rem; }
    .book-year-value svg { width: 12px; }
  }
</style>

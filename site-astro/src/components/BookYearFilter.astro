---
interface Props { years: number[]; id: string; }
const { years, id } = Astro.props;
---
<label class="book-year-filter" for={id}>
  <span class="book-filter-label">Year</span>
  <span class="book-year-value">
    <select id={id} data-book-year-filter aria-label="Filter by year read">
      <option value="all" selected>All years</option>
      {years.map((year) => <option value={year}>{year}</option>)}
    </select>
    <svg class="ico-stroke" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><use href="#icon-chevronDown"></use></svg>
  </span>
</label>

<style is:global>
  .book-year-filter {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: .3rem;
    min-width: 0;
    padding: .7rem .8rem;
    color: var(--text-color);
  }
  .book-filter-label {
    color: var(--text-light);
    font-size: .6rem;
    font-weight: 500;
    letter-spacing: .12em;
    line-height: 1;
    text-transform: uppercase;
  }
  .book-year-value { display: flex; align-items: center; position: relative; min-width: 0; }
  .book-year-value select {
    appearance: none;
    width: 100%;
    min-width: 0;
    padding: 0 1.1rem 0 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: .85rem;
    line-height: 1.4;
    cursor: pointer;
  }
  .book-year-value select option { background: var(--background); color: var(--text-color); }
  .book-year-value svg { position: absolute; right: 0; pointer-events: none; }
  .book-year-value select:focus-visible { outline: 2px solid var(--secondary-color); outline-offset: 4px; }
  @media (width <= 400px) {
    .book-year-filter { padding: .65rem .4rem; }
    .book-year-value select { padding-right: .85rem; font-size: .8rem; }
    .book-year-value svg { width: 12px; }
  }
</style>

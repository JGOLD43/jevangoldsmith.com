---
// Reading stats panel. Mirrors the structure of MovieStatsBody.astro:
// headline cards on top, then a few distributions. Pure derivation from
// the books data passed in — no runtime fetches.

interface BookLite {
  title?: string | null;
  author?: string | null;
  rating?: number | null;
  category?: string | null;
  read?: boolean | null;
  reReads?: number | null;
  year?: string | number | null;
  coverImage?: string | null;
}

interface Props { books: BookLite[]; }

const { books } = Astro.props as Props;
const list = Array.isArray(books) ? books : [];

const totalBooks = list.length;
const readBooks = list.filter((b) => b.read !== false);
const toReadBooks = list.filter((b) => b.read === false);
const ratedBooks = readBooks.filter((b) => typeof b.rating === 'number' && (b.rating as number) > 0);
const avgRating = ratedBooks.length
  ? (ratedBooks.reduce((acc, b) => acc + ((b.rating as number) || 0), 0) / ratedBooks.length)
  : 0;
const totalReReads = list.reduce((acc, b) => acc + (Number(b.reReads) || 0), 0);
const readPercent = totalBooks ? Math.round((readBooks.length / totalBooks) * 100) : 0;

// Top categories.
const categoryCounts: Record<string, number> = {};
list.forEach((b) => {
  const c = (b.category || '').trim();
  if (!c) return;
  categoryCounts[c] = (categoryCounts[c] || 0) + 1;
});
const topCategories = Object.entries(categoryCounts).sort((a, b) => b[1] - a[1]).slice(0, 6);
---

<div class="stats-headline-grid">
  <div class="stats-headline-card"><div class="stats-headline-value">{totalBooks.toLocaleString()}</div><div class="stats-headline-label">Total books</div></div>
  <div class="stats-headline-card"><div class="stats-headline-value">{readBooks.length.toLocaleString()}</div><div class="stats-headline-label">Read</div></div>
  <div class="stats-headline-card"><div class="stats-headline-value">{toReadBooks.length.toLocaleString()}</div><div class="stats-headline-label">To read</div></div>
  <div class="stats-headline-card"><div class="stats-headline-value">{avgRating ? avgRating.toFixed(1) : '—'}</div><div class="stats-headline-label">Avg rating</div></div>
</div>

<div class="stats-overview-grid">
  <section class="stats-compact-section" aria-labelledby="reading-progress-title">
    <h3 class="stats-section-title" id="reading-progress-title">Reading progress</h3>
    <div class="stats-progress-copy">
      <strong>{readPercent}%</strong>
      <span>{readBooks.length.toLocaleString()} of {totalBooks.toLocaleString()} books read</span>
    </div>
    <div class="stats-progress-track" aria-hidden="true">
      <span style={`width: ${readPercent}%`}></span>
    </div>
    <div class="stats-inline-notes">
      <span>{toReadBooks.length.toLocaleString()} queued</span>
      <span>{totalReReads.toLocaleString()} re-read{totalReReads === 1 ? '' : 's'}</span>
    </div>
  </section>

  {topCategories.length > 0 && (
    <section class="stats-compact-section" aria-labelledby="top-categories-title">
      <h3 class="stats-section-title" id="top-categories-title">Top categories</h3>
      <ol class="stats-category-list">
        {topCategories.map(([name, count]) => (
          <li><span>{name}</span><strong>{count}</strong></li>
        ))}
      </ol>
    </section>
  )}
</div>

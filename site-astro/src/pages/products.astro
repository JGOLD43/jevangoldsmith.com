---
import fs from 'node:fs';
import path from 'node:path';
import raw from '../../../data/products.json';
import Base from '../layouts/Base.astro';

// Resolve product image to its optimized generated raster (mirrors
// scripts/legacy-build/build/cards.js generatedProductImageAsset).
// Astro runs the build from site-astro/, so the repo root is one level up.
const ROOT = path.resolve(process.cwd(), '..');
function productImageAsset(slug?: string, fallbackImage?: string) {
  if (!slug) return null;
  const widths = [240, 400, 640, 800];
  for (const ext of ['jpg', 'png'] as const) {
    const rel = `images/generated/products/${slug}-640.${ext}`;
    if (!fs.existsSync(path.join(ROOT, rel))) continue;
    const srcset = widths
      .filter((w) => fs.existsSync(path.join(ROOT, `images/generated/products/${slug}-${w}.${ext}`)))
      .map((w) => `/images/generated/products/${slug}-${w}.${ext} ${w}w`)
      .join(', ');
    return { src: `/${rel}`, srcset, sizes: '(max-width: 768px) 78vw, 320px', width: 800, height: 800 };
  }
  if (fallbackImage && fs.existsSync(path.join(ROOT, fallbackImage))) {
    const absSrc = fallbackImage.startsWith('/') ? fallbackImage : `/${fallbackImage}`;
    return { src: absSrc, srcset: '', sizes: '', width: 800, height: 800 };
  }
  return null;
}

interface Product {
  id: string;
  slug?: string;
  title: string;
  objectType?: string;
  brand?: string;
  type?: string;
  category?: string;
  status?: string;
  price?: string | number;
  shortDescription?: string;
  description?: string;
  rating?: number;
  badge?: string;
  image?: string;
  ctaLabel?: string;
  checkoutUrl?: string;
  verdict?: string;
  whyItStayed?: string;
  howIUseIt?: string;
  replaced?: string;
  usage?: string;
  icon?: string;
  relatedContent?: string[];
}

interface Category {
  id: string;
  title: string;
  icon?: string;
}

type ProductsData = {
  products?: Product[];
  productCategories?: Category[];
};

const productsData = raw as ProductsData;
const products = productsData.products ?? [];
const categories = productsData.productCategories ?? [];
const categoryLabels = Object.fromEntries(categories.map((category) => [category.id, category.title]));
const categoryCounts = Object.fromEntries(
  categories.map((category) => [
    category.id,
    products.filter((product) => (product.category ?? '').toLowerCase() === category.id).length,
  ]),
);
---
<Base
  title="Recommended Tools, Gear & Objects | Jevan Goldsmith"
  description="A personal archive of objects Jevan Goldsmith actually uses, why they stayed, and what they replaced."
  canonical="https://jevangoldsmith.com/products.html"
  pageType="CollectionPage"
>
  <main class="shelf-page">
    <h1 class="sr-only">The Shelf: Tools, Objects &amp; Gear That Earned Their Place</h1>

    <header class="shelf-topbar">
      <div class="shelf-brand">the shelf<span class="shelf-count">{products.length} items</span></div>
      <nav class="shelf-filter" data-shelf-filter aria-label="Shelf filters">
        <button type="button" class="active" data-shelf-category="all">all<span class="count">{products.length}</span></button>
        {categories.map((c) => (
          <button type="button" data-shelf-category={c.id}>{c.title.toLowerCase()}<span class="count">{categoryCounts[c.id]}</span></button>
        ))}
      </nav>
    </header>

    <section class="shelf-grid" aria-label="Objects on the shelf">
      {products.map((p, i) => {
        const asset = productImageAsset(p.slug ?? p.id, p.image);
        const generalLabel = p.objectType?.trim()
          || categoryLabels[(p.category ?? '').toLowerCase()]
          || 'Object';
        return (
        <article
          class="shelf-item"
          id={p.id}
          data-shelf-card
          data-category={(p.category ?? '').toLowerCase()}
          style={`--shelf-index: ${i}`}
        >
          <button
            class="shelf-object"
            type="button"
            data-shelf-item
            data-id={p.id}
            data-title={p.title}
            data-brand={p.brand ?? ''}
            data-category={p.category ?? ''}
            data-verdict={p.verdict ?? p.shortDescription ?? ''}
            data-why={p.whyItStayed ?? ''}
            data-how={p.howIUseIt ?? ''}
            data-replaced={p.replaced ?? ''}
            data-usage={p.usage ?? ''}
            data-icon={p.icon ?? ''}
            data-image={asset?.src ?? p.image ?? ''}
            data-related={(p.relatedContent ?? []).join('|')}
            data-link={p.checkoutUrl ?? ''}
          >
            <span class="shelf-object-stage has-photo" aria-hidden="true">
              <span class="shelf-object-mark">
                {asset && (
                  <picture>
                    <source type="image/avif" srcset={asset.srcset.replace(/\.png\b/g, '.avif')} sizes={asset.sizes} />
                    <img
                      class="shelf-object-photo"
                      src={asset.src}
                      srcset={asset.srcset}
                      sizes={asset.sizes}
                      alt={p.title}
                      width={asset.width}
                      height={asset.height}
                      loading="eager"
                      fetchpriority={i < 6 ? 'high' : 'auto'}
                      decoding="async"
                    />
                  </picture>
                )}
                {!p.image && p.icon && <span class="shelf-object-icon">{p.icon}</span>}
              </span>
            </span>
            <span class="shelf-object-name shelf-object-name--general">{generalLabel}</span>
            <span class="shelf-object-name shelf-object-name--specific">{p.title}</span>
            {(p.verdict || p.shortDescription) && (
              <span class="shelf-object-verdict">{p.verdict ?? p.shortDescription}</span>
            )}
          </button>

          <div class="shelf-object-detail" aria-hidden="true">
            {p.brand && <p class="shelf-object-detail-brand">{p.brand}</p>}
            {(p.verdict || p.shortDescription) && (
              <p class="shelf-object-detail-verdict">{p.verdict ?? p.shortDescription}</p>
            )}
            <button type="button" class="shelf-object-detail-more" data-shelf-detail-more aria-expanded="false">See further description</button>
            <div class="shelf-object-detail-extra">
              {p.whyItStayed && (
                <p class="shelf-object-detail-line"><strong>Why it stayed:</strong> {p.whyItStayed}</p>
              )}
              {p.howIUseIt && (
                <p class="shelf-object-detail-line"><strong>How I use it:</strong> {p.howIUseIt}</p>
              )}
              {p.replaced && (
                <p class="shelf-object-detail-line"><strong>Replaced:</strong> {p.replaced}</p>
              )}
              {p.usage && (
                <p class="shelf-object-detail-line">{p.usage}</p>
              )}
              {p.checkoutUrl && (
                <a
                  href={p.checkoutUrl}
                  class="shelf-object-detail-link"
                  target="_blank"
                  rel="noopener"
                >
                  {p.ctaLabel ?? 'View'}
                </a>
              )}
            </div>
          </div>
        </article>
        );
      })}
    </section>

  </main>
</Base>

<style is:global>
  .shelf-page {
    padding-top: 0;
  }

  .shelf-page .shelf-topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin: 0 -20px 28px;
    padding: 18px 32px;
    border-bottom: 1px solid transparent;
    background: transparent;
    color: #f0f0f0;
    font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 13px;
    line-height: 1.4;
    flex-wrap: wrap;
  }

  .shelf-page .shelf-brand {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .shelf-page .shelf-count {
    margin-left: 8px;
    color: #8a8a8a;
    font-weight: 400;
  }

  .shelf-page .shelf-count::before {
    content: '/ ';
  }

  .shelf-page .shelf-filter {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: normal;
    max-width: none;
    margin: 0 0 0 -8px;
  }

  .shelf-page .shelf-filter button {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 7px;
    min-height: auto;
    padding: 4px 8px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: #8a8a8a;
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: none;
    white-space: nowrap;
  }

  .shelf-page .shelf-filter button:hover,
  .shelf-page .shelf-filter button.active {
    color: #f0f0f0;
  }

  .shelf-page .shelf-filter button.active {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .shelf-page .shelf-filter button .count {
    margin-left: 4px;
    padding: 0;
    background: transparent;
    color: #8a8a8a;
    font-size: 11px;
  }

  .shelf-page .shelf-filter button.active .count {
    color: #f0f0f0;
    opacity: 0.55;
  }

  body.zoom-open .shelf-page .shelf-filter {
    opacity: 1;
    pointer-events: auto;
  }

  /* The zoomed grid is transformed visually and therefore does not push the
     footer down in document flow. Keep the footer's space (so scrollY cannot
     jump) but hide its contents while a Shelf item owns the viewport. */
  body.shelf-experience.zoom-open .site-footer {
    visibility: hidden;
    pointer-events: none;
  }

  .shelf-page .shelf-object-stage {
    margin-bottom: -36px;
  }

  .shelf-page .shelf-object-name--specific {
    display: none;
  }

  .shelf-page .shelf-grid.is-zoomed .shelf-item.is-zoom-target .shelf-object-name--general {
    display: none;
  }

  .shelf-page .shelf-grid.is-zoomed .shelf-item.is-zoom-target .shelf-object-name--specific {
    display: block;
  }

  @media (min-width: 761px) {
    .shelf-page .shelf-object-detail {
      top: 50%;
      transform: translate(14px, -50%);
    }

    .shelf-page .shelf-grid.is-zoomed .shelf-item.is-zoom-target .shelf-object-name {
      font-size: 0.72rem;
      line-height: 1.2;
    }

    .shelf-page .shelf-grid.is-zoomed .shelf-item.is-zoom-target .shelf-object-detail {
      gap: 0.42rem;
      width: clamp(190px, 15vw, 230px);
      height: clamp(120px, 17vw, 245px);
      font-size: 0.56rem;
      line-height: 1.4;
      transform: translate(0, -50%);
    }

    .shelf-page .shelf-grid.is-zoomed .shelf-item.is-zoom-target .shelf-object-detail-brand {
      font-size: 0.5rem;
    }

    .shelf-page .shelf-grid.is-zoomed .shelf-item.is-zoom-target .shelf-object-detail-verdict {
      margin-bottom: 0.2rem;
      font-size: 0.72rem;
      line-height: 1.25;
    }
  }

  @media (max-width: 760px) {
    .shelf-page .shelf-topbar {
      margin: -24px -12px 24px;
      padding: 14px 16px;
    }

    .shelf-page .shelf-object-stage {
      margin-bottom: 0;
    }
  }
</style>

<script>
  import '../scripts/shelf.ts';
</script>

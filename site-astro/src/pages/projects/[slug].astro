---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const visible = projects.filter((entry: any) =>
    entry.data.status !== 'draft' && entry.data.visibility !== 'private'
  );
  return visible.map((entry: any) => ({
    params: { slug: entry.data.slug || entry.id },
    props: { entry }
  }));
}

const { entry } = Astro.props as { entry: any };
const p = entry.data;
const slug = p.slug || entry.id;
const canonical = `https://jevangoldsmith.com/projects/${slug}.html`;

const status = String(p.status || 'planned').toLowerCase();
const statusLabel = status.charAt(0).toUpperCase() + status.slice(1);
const category = p.category ? String(p.category) : '';

const links = Array.isArray(p.links) ? p.links : [];

const heroImage = p.image || '';
const heroAlt = p.imageAlt || p.title;
---
<Base
  title={`${p.title} - Projects - Jevan Goldsmith`}
  description={p.shortDescription || p.description || `${p.title} project notes and build log.`}
  canonical={canonical}
  bodyClass="nav-compact"
  pageType="Article"
  ogImage={heroImage && heroImage.startsWith('http') ? heroImage : undefined}
  breadcrumbs={[
    { name: 'Home', url: 'https://jevangoldsmith.com/' },
    { name: 'Projects', url: 'https://jevangoldsmith.com/projects.html' },
    { name: p.title, url: canonical }
  ]}
>
  <main class="detail-page detail-page--project">
    <a href="/projects.html" class="detail-back">← Back to Projects</a>

    <header class="detail-hero detail-hero--task">
      {heroImage && (
        <div class="detail-hero-image">
          <img src={heroImage} alt={heroAlt} loading="eager" decoding="async" width="600" height="400" />
        </div>
      )}
      <div class="detail-hero-body">
        <p class="detail-kicker">
          <span class={`detail-status-badge status-${status}`}>{statusLabel}</span>
          {category && <span class="detail-category-pill">{category}</span>}
        </p>
        <h1 class="detail-title">{p.title}</h1>
        {p.shortDescription && <p class="detail-lead">{p.shortDescription}</p>}
        {links.length > 0 && (
          <div class="detail-link-row">
            {links.map((l: any) => (
              <a class="detail-link-pill" href={typeof l.url === 'string' && /^[a-z0-9-]+\.html(?:[?#]|$)/i.test(l.url) ? `/${l.url}` : l.url} target={l.url?.startsWith('http') ? '_blank' : undefined} rel={l.url?.startsWith('http') ? 'noopener noreferrer' : undefined}>
                {l.label}
              </a>
            ))}
          </div>
        )}
      </div>
    </header>

    {p.studioHtml && <section class="detail-story" set:html={p.studioHtml} />}
    {!p.studioHtml && <div class="project-documentary">
      {p.whatItIs && <section><h2>What I'm building</h2><p>{p.whatItIs}</p></section>}
      {p.whyIMadeIt && <section><h2>Why it exists</h2><p>{p.whyIMadeIt}</p></section>}
      {p.currentQuestion && <section><h2>The question I'm working through</h2><p>{p.currentQuestion}</p></section>}
      {p.whatILearned && <section><h2>What I've learned</h2><p>{p.whatILearned}</p></section>}
      {p.proofArtifacts?.length > 0 && <section><h2>Where it stands</h2><dl>{p.proofArtifacts.map((item: any) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}</dl></section>}
      {p.nextStep && <section><h2>What's next</h2><p>{p.nextStep}</p></section>}
      {p.buildLog?.length > 0 && <section><h2>Build notes</h2><ol class="project-build-log">{[...p.buildLog].sort((a: any, b: any) => String(b.date).localeCompare(String(a.date))).map((note: any) => <li><time datetime={note.date}>{note.date}</time><h3>{note.title}</h3><p>{note.note}</p></li>)}</ol></section>}
    </div>}
    <NewsletterSignup id="project-signup" source={`project:${slug}`} title="Follow this project as it develops." />
  </main>
</Base>

<style>
  .project-documentary { max-width: 760px; margin: 2rem auto; color: var(--text-color); }
  .project-documentary section { padding: 1.5rem 0; border-top: 1px solid var(--border-color); }
  .project-documentary h2 { font-family: Chivo, sans-serif; font-size: 1.5rem; letter-spacing: -.025em; line-height: 1.3; margin: 0 0 1rem; }
  .project-documentary p, .project-documentary dd { font-size: 1rem; line-height: 1.8; color: var(--text-light); margin: 0 0 .8rem; }
  .project-documentary dt { font-weight: 600; font-size: .9rem; margin: 1rem 0 .35rem; }
  .project-build-log { list-style: none; padding: 0; }
  .project-build-log li { margin-bottom: 1.5rem; }
  .project-build-log time { color: var(--text-light); font-size: .75rem; }
  .project-build-log h3 { font-size: 1.05rem; margin: .5rem 0; }
</style>

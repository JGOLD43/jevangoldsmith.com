---
import Base from '../../layouts/Base.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { publishedEssays, essayUrl, essayDescription, essayDate, readingMinutes, relatedEssays, type Essay } from '../../lib/essays';
import '../../styles/publication.css';
export function getStaticPaths() { return publishedEssays.map((essay) => ({ params: { slug: essay.id }, props: { essay } })); }
const { essay } = Astro.props as { essay: Essay };
const canonical = `https://jevangoldsmith.com${essayUrl(essay.id)}`;
const related = relatedEssays(essay);
const ogImage = `https://jevangoldsmith.com/images/essays/${encodeURIComponent(essay.id)}.png`;
const modified = essay.updatedAt || essay.date;
const schema = { '@context': 'https://schema.org', '@type': 'BlogPosting', '@id': `${canonical}#article`, mainEntityOfPage: canonical, headline: essay.title, description: essayDescription(essay), datePublished: essay.date, dateModified: modified, author: { '@type': 'Person', name: essay.author || 'Jevan Goldsmith', url: 'https://jevangoldsmith.com/about.html' }, image: ogImage, inLanguage: 'en' };
---
<Base title={`${essay.title} | Jevan Goldsmith`} description={essayDescription(essay)} canonical={canonical} ogType="article" ogImage={ogImage} breadcrumbs={[{name:'Home',url:'https://jevangoldsmith.com/'},{name:'Essays',url:'https://jevangoldsmith.com/essays.html'},{name:essay.title,url:canonical}]}>
  <Fragment slot="head"><meta property="article:published_time" content={essay.date} /><meta property="article:modified_time" content={modified} /><meta property="article:author" content="Jevan Goldsmith" /></Fragment>
  <main class="publication essay-page">
    <article>
      <header><a class="text-link" href="/essays.html">← All essays</a><p class="eyebrow essay-category">{essay.category}</p><h1>{essay.title}</h1>{essay.subtitle && <p class="lead">{essay.subtitle}</p>}<div class="writing-meta"><a href="/about.html">{essay.author || 'Jevan Goldsmith'}</a><time datetime={essay.date}>{essayDate(essay.date)}</time><span>{readingMinutes(essay)} min read</span></div></header>
      <div class="prose essay-body" set:html={essay.content} />
    </article>
    <aside class="author-note" aria-label="About the author"><p><strong>Written by Jevan Goldsmith.</strong> I’m interested in attention, work, and the ideas we live by. I’m also starting a pet food business. <a href="/about.html">More about me</a>.</p><p><a href={`mailto:hello@jevangoldsmith.com?subject=${encodeURIComponent(`Re: ${essay.title}`)}`}>Send me a thought about this essay</a> · <button class="copy-essay" type="button" data-copy-essay>Copy link</button><span class="share-status" role="status" aria-live="polite"></span></p></aside>
    <NewsletterSignup id="essay-signup" source={`essay-${essay.id}`} />
    {related.length > 0 && <section class="publication-section" aria-labelledby="next-title"><h2 id="next-title">Read next</h2><ul class="writing-list">{related.map((item) => <li><h3><a href={essayUrl(item.id)}>{item.title}</a></h3><p>{essayDescription(item)}</p></li>)}</ul><a class="text-link" href="/start-here.html">Find another starting point →</a></section>}
  </main>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema).replace(/</g, '\u003c')} />
</Base>
<script>
  document.querySelector<HTMLButtonElement>('[data-copy-essay]')?.addEventListener('click', async () => {
    const status = document.querySelector<HTMLElement>('.share-status');
    try { await navigator.clipboard.writeText(document.querySelector<HTMLLinkElement>('link[rel="canonical"]')!.href); if (status) status.textContent = ' Link copied.'; }
    catch { if (status) status.textContent = ' Copy the address from your browser to share this essay.'; }
  });
</script>
<style>
  .essay-page { max-width: 780px; }
  .essay-page h1 { font-size: clamp(2.25rem, 5.5vw, 3.6rem); line-height: 1.12; }
  .essay-category { margin-top: 2rem; }
  .essay-page header { padding-bottom: 2.5rem; }
  .essay-body { overflow-wrap: break-word; }
  .author-note { border-top: 1px solid var(--border-color); padding: 1.5rem 0; margin-top: 2.5rem; font-size: .9rem; color: var(--text-light); }
  .copy-essay { padding: 0; border: 0; color: inherit; background: none; font: inherit; text-decoration: underline; text-underline-offset: 4px; cursor: pointer; }
  .share-status { display: inline; font-size: .8rem; }
</style>

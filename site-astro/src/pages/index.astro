---
import Base from '../layouts/Base.astro';
import EssayPicks from '../components/EssayPicks.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { publishedEssays, selectedEssays, essayUrl, essayDescription, essayDate, readingMinutes } from '../lib/essays';
import { NOW_SECTIONS, NOW_LAST_UPDATED } from '../lib/now-location';
import '../styles/publication.css';
const featured = selectedEssays[0] || publishedEssays[0];
---
<Base title="Jevan Goldsmith — Essays on attention, work & life" description="Essays by Jevan Goldsmith on attention, culture and starting again. Explore the writing, books, projects and a monthly letter." canonical="https://jevangoldsmith.com/" pageType="WebSite" bodyClass="publication-home">
  <main class="publication">
    <header class="publication-intro">
      <div>
        <p class="eyebrow">Jevan Goldsmith · Essays & a monthly letter</p>
        <h1>A place to think<br />things through.</h1>
        <p class="lead">I’m Jevan. I write about attention, how we work, and the way we move through life. I’m also starting a pet food business, reading, and making things.</p>
        <div class="reading-links"><a class="primary-link" href="/start-here.html">Start reading <span aria-hidden="true">→</span></a><a class="text-link" href="/about.html">A little about me</a></div>
      </div>
      {featured && <aside class="featured-essay" aria-label="Featured essay"><p class="eyebrow">A place to begin</p><h2><a href={essayUrl(featured.id)}>{featured.title}</a></h2><p>{essayDescription(featured)}</p><p class="writing-meta">{featured.category} · {readingMinutes(featured)} min read</p><a class="text-link" href={essayUrl(featured.id)}>Read the essay <span aria-hidden="true">→</span></a></aside>}
      <a class="publication-portrait" href="/about.html" aria-label="About Jevan Goldsmith"><img src="/images/generated/profile/profile-360.jpg" alt="Jevan Goldsmith" width="360" height="393" fetchpriority="high" /></a>
    </header>
    <section class="publication-section" aria-labelledby="selected-title">
      <div class="publication-section-heading"><h2 id="selected-title">Three places to begin</h2><a class="text-link" href="/essays.html">All essays <span aria-hidden="true">→</span></a></div>
      <EssayPicks />
    </section>
    <section class="publication-section" aria-labelledby="recent-title">
      <div class="publication-section-heading"><h2 id="recent-title">Latest essays</h2><a class="text-link" href="/rss.xml">Follow via RSS</a></div>
      <ul class="writing-list">{publishedEssays.slice(0, 3).map((essay) => <li><div class="writing-meta"><time datetime={essay.date}>{essayDate(essay.date)}</time><span>{essay.category}</span></div><h3><a href={essayUrl(essay.id)}>{essay.title}</a></h3><p>{essayDescription(essay)}</p></li>)}</ul>
      <p class="muted">For shorter pieces and practical notes, explore <a href="/updates.html">notes from the work</a>.</p>
    </section>
    <NewsletterSignup id="home-signup" source="home-writing" />
    <section class="publication-section personal-section" aria-labelledby="now-title">
      <div><p class="eyebrow">Away from the page · {NOW_LAST_UPDATED}</p><h2 id="now-title">What I’m working on</h2>{NOW_SECTIONS.slice(0, 1).map((section) => <><h3>{section.title}</h3><div class="muted" set:html={section.body} /></>)}<a class="text-link" href="/now.html">Read the current update <span aria-hidden="true">→</span></a></div>
      <div><p class="eyebrow">The rest of the site</p><h2>Follow a curiosity</h2><p class="muted">The books, projects and places behind the writing.</p><div class="reading-links"><a href="/books.html">Reading</a><a href="/projects.html">Projects</a><a href="/adventures.html">Trips</a><a href="/explore.html">Explore everything →</a></div></div>
    </section>
  </main>
</Base>
<style>
  .publication-intro { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 3rem; align-items: center; padding: 1rem 0 3.5rem; }
  .featured-essay { padding: 2rem; border: 1px solid var(--border-color); border-top: 4px solid #d4b329; background: var(--card-bg, var(--background)); }
  .featured-essay h2 { font-size: 1.8rem; }
  .featured-essay h2 a { text-decoration: none; }
  .featured-essay p { color: var(--text-light); margin: 1rem 0; }
  .publication-portrait { display: none; width: 190px; justify-self: center; }
  :global(html[data-mode="personal"]) .publication-portrait { display: block; }
  :global(html[data-mode="personal"]) .featured-essay { display: none; }
  .publication-portrait img { width: 100%; height: auto; border-radius: 3px; filter: saturate(.75); }
  .personal-section { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
  @media (max-width: 680px) { .publication-intro { grid-template-columns: 1fr; padding: 0 0 2rem; gap: 1.5rem; } .featured-essay { padding: 1.5rem; } .personal-section { grid-template-columns: 1fr; gap: 2.5rem; } }
</style>

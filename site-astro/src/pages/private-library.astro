---
// Deliberately standalone: no analytics, third-party assets or service worker.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>Private library · Jevan Goldsmith</title>
  </head>
  <body>
    <main>
      <a href="/books.html">← Public books</a>
      <header><p class="eyebrow">ONLY FOR YOU</p><h1>Private library</h1><p>Your synced books, highlights and notes. Unlocked in this browser; nothing here is published.</p></header>
      <section id="connection">
        <h2>Open your synced library</h2>
        <ol><li>In the phone app, open Settings → Phone & Mac sync. Enable sync, then tap Sync now.</li><li>Copy its connection code. An already connected Mac uses the same code.</li><li>Use a <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener noreferrer">GitHub token</a> for JGOLD43 / jgold-publishing-inbox with Contents: read-only access.</li></ol>
        <form id="unlock">
          <label for="code">Connection code</label><input id="code" type="password" autocomplete="off" spellcheck="false" placeholder="JG1.…" required />
          <label for="token">GitHub read-only token</label><input id="token" type="password" autocomplete="off" spellcheck="false" required />
          <button type="submit">Open private library</button>
        </form>
        <p class="muted">The token goes only to GitHub. The connection code stays in this page. Neither is saved by the page. Use a trusted personal browser; Lock or closing the page clears this session.</p>
      </section>
      <p id="status" role="status" aria-live="polite"></p>
      <section id="library" hidden>
        <div class="toolbar"><button id="refresh" type="button">Refresh</button><button id="lock" type="button">Lock</button><span id="summary"></span></div>
        <label for="search">Search books, highlights and notes</label><input id="search" type="search" autocomplete="off" placeholder="Find a passage or a book…" />
        <p class="muted">Refreshes every minute while this page is visible. This view reads the last successful app sync. Make edits in the phone or Mac app, then sync there. Book files are not downloaded.</p>
        <div id="books"></div>
      </section>
    </main>
    <script>
      import { loadPrivateLibrary, type PrivateBook } from '../lib/private-library';
      const input = (id: string) => document.getElementById(id) as HTMLInputElement;
      const element = (id: string) => document.getElementById(id)!;
      let session: { token: string; code: string } | null = null;
      let books: PrivateBook[] = [];
      let revision = 0, idle: ReturnType<typeof setTimeout> | undefined;
      let pending: AbortController | null = null;
      const refreshButton = element('refresh') as HTMLButtonElement;
      const submit = document.querySelector<HTMLButtonElement>('#unlock button')!;
      function node(tag: string, text: string) { const result = document.createElement(tag); result.textContent = text; return result; }
      function render() {
        const query = input('search').value.toLocaleLowerCase().trim();
        const container = element('books'); container.replaceChildren();
        const filtered = books.filter(book => [book.title, book.author, ...book.highlights.flatMap(h => [h.text, h.note])].some(value => value.toLocaleLowerCase().includes(query)));
        element('summary').textContent = `${books.length} books · ${books.reduce((sum, book) => sum + book.highlights.length, 0)} highlights & notes`;
        for (const book of filtered) {
          const article = node('article', '');
          article.append(node('h2', book.title), node('p', `${book.author || 'Unknown author'} · ${book.highlights.length} highlights & notes`));
          if (!book.highlights.length) article.append(node('p', 'No synced highlights or notes for this book.'));
          for (const h of book.highlights) {
            if (query && ![book.title, book.author, h.text, h.note].some(value => value.toLocaleLowerCase().includes(query))) continue;
            const passage = node('section', '');
            if (h.text) passage.append(node('blockquote', h.text));
            if (h.note) passage.append(node('p', `Note: ${h.note}`));
            if (h.locator && !h.locator.startsWith('{')) passage.append(node('small', h.locator));
            article.append(passage);
          }
          container.append(article);
        }
        if (!filtered.length) container.append(node('p', query ? 'No matching books or passages.' : 'No books in this sync yet. Sync the device containing your books and highlights, then Refresh.'));
      }
      function lock() {
        revision++; pending?.abort(); pending = null; session = null; books = [];
        clearTimeout(idle); input('code').value = ''; input('token').value = ''; input('search').value = '';
        element('books').replaceChildren(); element('summary').textContent = '';
        element('library').hidden = true; element('connection').hidden = false;
        submit.disabled = false; refreshButton.disabled = false;
        element('status').textContent = 'Locked. Enter your connection details to open again.';
      }
      function resetIdle() { if (session) { clearTimeout(idle); idle = setTimeout(lock, 15 * 60_000); } }
      async function refresh() {
        if (!session || pending) return;
        const expected = revision, controller = new AbortController(); pending = controller;
        const timeout = setTimeout(() => controller.abort(), 30_000);
        submit.disabled = true; refreshButton.disabled = true;
        element('status').textContent = 'Reading encrypted sync data…';
        try {
          const incoming = await loadPrivateLibrary(session.token, session.code, controller.signal);
          if (revision !== expected) return;
          books = incoming; render(); element('connection').hidden = true; element('library').hidden = false;
          element('status').textContent = `Last refreshed ${new Date().toLocaleString()}. Only successfully synced changes are shown.`;
        } catch (error) {
          if (revision === expected) element('status').textContent = (controller.signal.aborted ? 'Refresh timed out. Check your connection and retry.' : error instanceof Error ? error.message : 'Could not refresh. Try again.') + (books.length ? ' Your last loaded library is still shown.' : '');
        } finally { clearTimeout(timeout); if (revision === expected) { pending = null; submit.disabled = false; refreshButton.disabled = false; } }
      }
      element('unlock').addEventListener('submit', event => { event.preventDefault(); session = { token: input('token').value.trim(), code: input('code').value.trim() }; input('token').value = ''; input('code').value = ''; resetIdle(); void refresh(); });
      element('refresh').addEventListener('click', () => void refresh()); element('lock').addEventListener('click', lock);
      input('search').addEventListener('input', render);
      for (const event of ['pointerdown', 'keydown']) document.addEventListener(event, resetIdle);
      window.addEventListener('pagehide', lock);
      setInterval(() => { if (document.visibilityState === 'visible') void refresh(); }, 60_000);
    </script>
    <style>
      :global(*){box-sizing:border-box} :global(body){margin:0;background:#faf9f6;color:#242424;font:16px/1.6 system-ui,sans-serif} main{max-width:900px;margin:auto;padding:32px 24px 80px} a{color:#6246a6} header{margin:36px 0} h1{font-size:clamp(32px,6vw,48px);line-height:1.15;margin:8px 0 20px} h2{font-size:22px;line-height:1.3}.eyebrow{font-size:12px;letter-spacing:2px;color:#6246a6}.muted,:global(#books small){color:#666;font-size:14px}#connection,:global(#books article){background:white;border:1px solid #e3e0d9;border-radius:16px;padding:24px;margin:20px 0}label{display:block;font-weight:600;margin:16px 0 6px}input{font:inherit;width:100%;padding:12px;border:1px solid #aaa;border-radius:8px}button{font:inherit;padding:10px 18px;border:1px solid #6246a6;border-radius:8px;background:#6246a6;color:white;cursor:pointer}button:disabled{opacity:.5;cursor:wait}form button{margin-top:20px}.toolbar{display:flex;flex-wrap:wrap;gap:12px;align-items:center}.toolbar span{margin-left:auto}:global(#books blockquote){margin:20px 0 8px;padding:8px 0 8px 16px;border-left:3px solid #b2a0d8;white-space:pre-wrap;overflow-wrap:anywhere}:global(#books article section p){white-space:pre-wrap;overflow-wrap:anywhere}#status{color:#6246a6} :global([hidden]){display:none!important}button:focus-visible,input:focus-visible,a:focus-visible{outline:3px solid #aa96d6;outline-offset:3px}@media(prefers-color-scheme:dark){:global(body){background:#181818;color:#eee}#connection,:global(#books article){background:#242424;border-color:#444}input{background:#181818;color:#eee;border-color:#666}a,.eyebrow,#status{color:#c5b3ed}.muted,:global(#books small){color:#bbb}}
    </style>
  </body>
</html>

---
import Base from '../layouts/Base.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { publishedEssays, essayUrl, essayDescription, essayDate, readingMinutes } from '../lib/essays';
import '../styles/publication.css';
---
<Base title="Essays | Jevan Goldsmith" description="Essays on attention, culture, work and life by Jevan Goldsmith. Find a place to begin or browse the complete archive." canonical="https://jevangoldsmith.com/essays.html" pageType="CollectionPage">
  <main class="publication essay-archive">
    <header><p class="eyebrow">The writing</p><h1>Essays</h1><p class="lead">Thoughts on attention, how we work, and the changes we live through.</p><p class="reading-links"><a href="/start-here.html">New here? Start with these</a><a href="/updates.html">Shorter notes</a><a href="/rss.xml">RSS feed</a></p></header>
    <ul class="writing-list" id="essays-list">{publishedEssays.map((essay) => <li id={essay.id} data-essay-id={essay.id}>
      <div class="writing-meta"><time datetime={essay.date}>{essayDate(essay.date)}</time><span>{essay.category}</span><span>{readingMinutes(essay)} min read</span></div>
      <h2><a href={essayUrl(essay.id)}>{essay.title}</a></h2><p>{essayDescription(essay)}</p>
    </li>)}</ul>
    <NewsletterSignup id="essay-signup" source="essay-archive" />
  </main>
</Base>
<script>
  // Preserve old links without treating arbitrary fragments as destinations.
  function followLegacyEssay() {
    let id: string;
    try { id = decodeURIComponent(window.location.hash.slice(1)); } catch { return; }
    const item = Array.from(document.querySelectorAll<HTMLElement>('[data-essay-id]')).find((entry) => entry.dataset.essayId === id);
    const link = item?.querySelector<HTMLAnchorElement>('h2 a');
    if (link) window.location.replace(link.pathname + window.location.search);
  }
  followLegacyEssay();
  window.addEventListener('hashchange', followLegacyEssay);
</script>
<style>.essay-archive { max-width: 820px; } header { padding-bottom: 2rem; }</style>

---
import interests from '../../../data/cool-shit.json';
import Base from '../layouts/Base.astro';
import { sanitizeUrl } from '../lib/url-server';

const items = interests.items;
const categories = interests.categories.filter(cat => items.some(item => item.category === cat.id));
const categoryNames = Object.fromEntries(categories.map(cat => [cat.id, cat.label]));
---
<Base
  title="Interests: Business, Books, Thinking & Adventure | Jevan Goldsmith"
  description="The things Jevan Goldsmith keeps coming back to: building businesses, understanding people, reading, writing, technology, and adventure. Follow the threads into his own notes and projects."
  canonical="https://jevangoldsmith.com/cool-shit.html"
  pageType="CollectionPage"
>
  <main class="interests-page">
    <header class="interests-intro">
      <div>
        <p class="interests-eyebrow">A map of my curiosity</p>
        <h1>Things I keep<br />coming back to<span>.</span></h1>
      </div>
      <div class="interests-lead">
        <p>Building things. Understanding people. Seeing more of the world.</p>
        <p>A few recurring threads from my books, essays, projects, and travels. Follow one and see where it leads.</p>
        <a href="/now.html">What I’m working on now <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <div class="interests-toolbar">
      <nav id="tag-rail" aria-label="Filter interests">
        <button class="interest-filter active" type="button" data-cat="all" aria-pressed="true">All <span>{items.length}</span></button>
        {categories.map(cat => (
          <button class="interest-filter" type="button" data-cat={cat.id} aria-pressed="false">
            {cat.label} <span>{items.filter(item => item.category === cat.id).length}</span>
          </button>
        ))}
      </nav>
      <p id="feed-count" role="status" aria-live="polite" aria-atomic="true">{items.length} interests</p>
    </div>

    <div class="interests-grid" id="feed">
      {items.map((item, index) => (
        <article class:list={['interest-card', { 'interest-featured': index === 0, 'interest-question': !!item.question, 'interest-illustrated': !!item.image }]}
          id={`item-${item.id}`} data-category={item.category}>
          {item.image && <img class="interest-image" src={item.image} alt="" width="800" height="450" loading="lazy" decoding="async" />}
          <div class="interest-copy">
            <div class="interest-meta"><span>{categoryNames[item.category]}</span><span>{String(index + 1).padStart(2, '0')}</span></div>
            {item.question && <p class="interest-prompt">{item.question}</p>}
            <h2>{item.title}</h2>
            <p class="interest-body">{item.body}</p>
            <a href={sanitizeUrl(item.url)}>{item.source} <span aria-hidden="true">↗</span></a>
          </div>
        </article>
      ))}
    </div>
    <p class="interests-colophon">An evolving collection, drawn from the archive. <a href="/books.html">Books</a> / <a href="/essays.html">Essays</a> / <a href="/adventures.html">Adventures</a></p>
  </main>
  <script>
    import '../scripts/cool-shit';
  </script>
</Base>

<style>
  .interests-page {
    --interest-paper: #f5f3ed;
    --interest-card: #faf8f2;
    --interest-ink: #22231e;
    --interest-muted: #64655d;
    --interest-line: #d5d3c9;
    background: var(--interest-paper);
    color: var(--interest-ink);
    padding: 0 clamp(18px, 4vw, 64px);
    font-family: 'JetBrains Mono', ui-monospace, monospace;
  }
  :global([data-theme='dark']) .interests-page {
    --interest-paper: #0f0f0f;
    --interest-card: #191a17;
    --interest-ink: #eeeee7;
    --interest-muted: #b3b4aa;
    --interest-line: #383a32;
  }
  .interests-intro { display: grid; grid-template-columns: 1.4fr 1fr; align-items: end; gap: 48px; padding: 64px 0 48px; max-width: 1440px; margin: auto; }
  .interests-eyebrow { font-size: 11px; text-transform: uppercase; letter-spacing: .14em; margin: 0 0 20px; color: var(--interest-muted); }
  h1 { font-family: inherit; font-size: clamp(30px, 4.1vw, 60px); font-weight: 600; line-height: 1.1; letter-spacing: -.06em; margin: 0; color: inherit; }
  h1 span { color: #a68b00; }
  :global([data-theme='dark']) h1 span { color: #ffdc00; }
  .interests-lead { max-width: 440px; font-size: 13px; line-height: 1.8; color: var(--interest-muted); }
  .interests-lead p { margin: 0 0 14px; }
  .interests-lead p:first-child { color: var(--interest-ink); }
  a { color: inherit; text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  a:hover { text-decoration-thickness: 2px; }
  a:focus-visible, button:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
  .interests-lead a { color: var(--interest-ink); font-size: 11px; }
  .interests-toolbar { max-width: 1440px; margin: auto; display: flex; align-items: center; justify-content: space-between; gap: 16px; border-block: 1px solid var(--interest-line); padding: 18px 0; }
  nav { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .interest-filter { font: inherit; font-size: 12px; padding: 6px 0; border: 0; border-radius: 0; background: none; color: var(--interest-muted); cursor: pointer; }
  .interest-filter span { font-size: 10px; margin-left: 3px; opacity: .8; }
  .interest-filter.active { color: var(--interest-ink); text-decoration: underline; text-underline-offset: 6px; }
  #feed-count { font-size: 10px; color: var(--interest-muted); white-space: nowrap; margin: 0; }
  .interests-grid { max-width: 1440px; margin: auto; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; padding: 28px 0 48px; align-items: start; }
  .interest-card { background: var(--interest-card); border: 1px solid var(--interest-line); min-width: 0; height: 100%; display: flex; flex-direction: column; }
  .interest-card[hidden] { display: none; }
  .interest-featured { grid-column: span 2; background: #ffdc00; color: #202116; border-color: #cbb000; }
  .interest-image { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-bottom: 1px solid var(--interest-line); }
  .interest-copy { padding: clamp(22px, 2.5vw, 36px); display: flex; flex-direction: column; flex: 1; }
  .interest-meta { display: flex; justify-content: space-between; gap: 16px; font-size: 10px; text-transform: uppercase; letter-spacing: .1em; color: var(--interest-muted); margin-bottom: 28px; }
  .interest-featured .interest-meta { color: #535022; }
  .interest-prompt { font-size: clamp(24px, 3.2vw, 46px); line-height: 1.18; letter-spacing: -.055em; margin: 0 0 32px; max-width: 18ch; }
  h2 { font: 600 19px/1.35 'JetBrains Mono', ui-monospace, monospace; letter-spacing: -.035em; color: inherit; margin: 0 0 14px; }
  .interest-body { font-size: 12px; line-height: 1.85; margin: 0 0 28px; color: var(--interest-muted); }
  .interest-featured .interest-body { color: #414021; max-width: 66ch; }
  .interest-copy a { font-size: 11px; line-height: 1.7; margin-top: auto; align-self: flex-start; }
  .interest-question:not(.interest-featured) { background: #e3e8dc; }
  :global([data-theme='dark']) .interest-question:not(.interest-featured) { background: #22291e; }
  .interests-colophon { max-width: 1440px; margin: auto; padding: 24px 0 48px; border-top: 1px solid var(--interest-line); font-size: 10px; line-height: 2; color: var(--interest-muted); }
  @media (min-width: 1500px) { .interest-body { font-size: 14px; } .interest-copy a { font-size: 12px; } }
  @media (max-width: 1000px) {
    .interests-intro { gap: 28px; padding-top: 40px; }
    .interests-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .interest-featured { grid-column: auto; }
    .interests-toolbar { align-items: flex-start; }
  }
  @media (max-width: 600px) {
    .interests-intro { grid-template-columns: 1fr; gap: 24px; padding: 32px 0; }
    .interests-lead { max-width: none; }
    .interests-grid { grid-template-columns: 1fr; gap: 16px; padding-top: 20px; }
    .interests-toolbar { flex-direction: column; gap: 10px; }
    nav { gap: 8px 18px; }
    .interest-copy { padding: 24px; }
    .interest-body { font-size: 13px; }
    .interest-prompt { font-size: 34px; }
    .interest-meta { margin-bottom: 22px; }
  }
</style>

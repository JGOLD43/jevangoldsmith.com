---
import Base from '../layouts/Base.astro';
import {
  NOW_LAST_UPDATED,
  NOW_LOCATION_LABEL,
  NOW_LAT,
  NOW_LNG,
  NOW_SECTIONS,
  nowMapThumbUrl,
  nowMapPinOffset,
} from '../lib/now-location';

const canonical = 'https://jevangoldsmith.com/now.html';

const lastUpdated = NOW_LAST_UPDATED;
const lastUpdatedLocation = NOW_LOCATION_LABEL;
const lastUpdatedLat = NOW_LAT;
const lastUpdatedLng = NOW_LNG;
const mapLink = `/adventures.html?focus=now&lat=${lastUpdatedLat}&lng=${lastUpdatedLng}&place=${encodeURIComponent(lastUpdatedLocation)}`;

const mapThumbUrl = nowMapThumbUrl();
const { leftPct: pinLeftPct, topPct: pinTopPct } = nowMapPinOffset();

const sections = NOW_SECTIONS;
---
<Base
  title="Now: Current Work, Reading & Life | Jevan Goldsmith"
  description="A snapshot of what I'm working on, reading, and thinking about right now. Updated occasionally."
  canonical={canonical}
  pageType="AboutPage"
>
  <Fragment slot="head">
    {/* Local same-origin tile — no crossorigin (would force a mismatched
        second fetch), no arcgis preconnect (no third-party request). */}
    <link rel="preload" as="image" fetchpriority="high" href={mapThumbUrl} />
  </Fragment>
<main class="now-page">
  <header class="now-header">
    <h1 class="now-title">Now</h1>
    <section class="now-overview" aria-label="Latest Now update">
      <a class="now-map-thumb" id="now-map-thumb-link" href={mapLink} title={`Open ${lastUpdatedLocation} on the trip map`} aria-label={`Open ${lastUpdatedLocation} on the trip map`}
         data-now-lat={lastUpdatedLat} data-now-lng={lastUpdatedLng}
         style="position:relative;display:block;width:64px;height:64px;border-radius:4px;overflow:hidden">
        <img id="now-map-thumb-img" src={mapThumbUrl} alt="" decoding="async" width="256" height="256" style="width:100%;height:100%;object-fit:cover;display:block" />
        <span class="now-map-thumb-marker" style={`position:absolute;left:${pinLeftPct}%;top:${pinTopPct}%;width:22px;height:22px;margin:-11px 0 0 -11px;pointer-events:none`} aria-hidden="true">
          <span class="now-marker-pulse" style="position:absolute;inset:0;background:rgba(255,215,0,0.5);border-radius:50%"></span>
          <span class="now-marker-dot" style="position:absolute;inset:6px;background:gold;border-radius:50%;box-shadow:0 2px 8px rgba(0,0,0,0.45)"></span>
        </span>
      </a>
      <div class="now-update-meta">
        <a class="now-location-link" href={mapLink}>
          <span class="now-map-thumb-label">{lastUpdatedLocation}</span>
          <span aria-hidden="true">↗</span>
        </a>
        <span class="now-updated-date">Updated {lastUpdated}</span>
        <a class="now-archive-cta" href="/now/archive.html">Past updates <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </header>

  <div class="now-sections">
    {sections.map((section) => (
      <section class="now-section">
        <h2 class="now-section-title">{section.title}</h2>
        <div class="now-section-body" set:html={section.body} />
      </section>
    ))}
  </div>

  <footer class="now-footer">
    <p>Want to know what I think about something not on this list? <a href="contact.html">Send a note</a> or browse the <a href="essays.html">essays</a>.</p>
  </footer>
</main>

<style is:global>
  .now-page {
    max-width: 824px;
    margin: 0 auto;
    padding: 2rem 2rem 4rem;
  }
  .now-header { margin-bottom: 2.5rem; }
  h1.now-title {
    font-family: Chivo, Georgia, serif;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.1;
    margin: 0 0 1.25rem;
    color: var(--primary-color);
    letter-spacing: -0.035em;
  }
  .now-overview {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .now-map-thumb {
    flex: none;
    background: var(--background-alt);
  }
  .now-map-thumb:hover, .now-map-thumb:focus-visible {
    outline: 2px solid var(--secondary-color);
    outline-offset: 3px;
  }
  .now-update-meta {
    display: grid;
    justify-items: start;
    gap: 0.15rem;
    min-width: 0;
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .now-location-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-color);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
  }
  .now-updated-date { color: var(--text-light); }
  .now-archive-cta {
    color: var(--text-light);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .now-location-link:hover, .now-archive-cta:hover { color: var(--secondary-color); }
  .now-marker-pulse { animation: nowPulse 1.8s ease-out infinite; }
  @keyframes nowPulse {
    0% { opacity: 0.9; transform: scale(0.6); }
    100% { opacity: 0; transform: scale(1.6); }
  }
  @media (prefers-reduced-motion: reduce) {
    .now-marker-pulse { animation: none; opacity: 0.5; transform: scale(1); }
  }

  .now-sections { display: grid; gap: 2.5rem; }
  .now-section {
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
  }
  .now-section:first-child { border-top: 0; padding-top: 0; }
  .now-section-title {
    font-family: Chivo, Georgia, serif;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 1rem;
    color: var(--primary-color);
  }
  .now-section-body {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--text-color);
  }
  .now-section-body p { margin: 0 0 1rem; }
  .now-section-body p:last-child { margin-bottom: 0; }
  .now-section-body a { color: var(--secondary-color); text-decoration: underline; text-underline-offset: 3px; }
  .now-section-body a:hover { color: var(--accent-color); }
  .now-section-body ul { margin: 0 0 1rem 1.25rem; padding: 0; }
  .now-section-body li { margin: 0 0 0.4rem; }

  .now-footer {
    max-width: 760px;
    margin-right: auto;
    margin-left: auto;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-color);
    font-size: 0.9rem;
    color: var(--text-light);
  }
  .now-footer a { color: var(--secondary-color); text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 600px) {
    .now-page { padding: 2rem 1.25rem 4rem; }
    h1.now-title { font-size: 2.25rem; }
    .now-sections { gap: 2rem; }
  }

  /* Thumb morphs into the destination overlay via shared
     view-transition-name. Imagery matches at zoom 10. */
  .now-map-thumb img {
    view-transition-name: now-thumb-image;
  }
</style>


<script>
  // SPA-swap to /adventures was removed (kept landing users in
  // inconsistent states). Now uses a plain navigation; the
  // adventures page initialises Leaflet on its own load path.

  // Snappy SPA swap. Target: <150ms perceived. No big zoom animation —
  // matching imagery means the swap itself is almost invisible. The
  // destination overlay (same zoom-10 tile, same lat/lng) sits where
  // the thumb was, then crossfades to the live map underneath.
  const link = document.getElementById('now-map-thumb-link') as HTMLAnchorElement | null;
  let prefetchedDoc: Document | null = null;

  if (link) {
    const prefetchDoc = async () => {
      if (prefetchedDoc) return;
      try {
        const res = await fetch(link.href, { credentials: 'same-origin', cache: 'no-cache' });
        if (!res.ok) return;
        prefetchedDoc = new DOMParser().parseFromString(await res.text(), 'text/html');
      } catch { /* ignore */ }
    };
    link.addEventListener('pointerenter', prefetchDoc, { once: true });
    link.addEventListener('touchstart', prefetchDoc, { once: true, passive: true });
    link.addEventListener('focus', prefetchDoc, { once: true });
    // Fire prefetch on initial page load too — by the time the user
    // gets to click the thumb, the doc is in memory.
    prefetchDoc();

    const img = link.querySelector('img') as HTMLImageElement | null;
    if (img && img.src) {
      const pre = document.createElement('link');
      pre.rel = 'preload';
      pre.as = 'image';
      pre.href = img.src;
      document.head.appendChild(pre);
    }

    // Plain navigation — no SPA swap. The prior in-page swap was
    // landing users in inconsistent states (sometimes the trip
    // story buried under the map, sometimes a half-initialised
    // Leaflet, sometimes nothing). A normal navigation reaches
    // /adventures cleanly, the page initialises Leaflet on its
    // own load path, and the View Transitions API (already
    // configured site-wide via @view-transition { navigation: auto })
    // handles the crossfade.
    link.addEventListener('click', () => {
      // Let the prefetched doc warm the HTTP cache but don't try
      // to swap — just let the browser navigate naturally.
      void prefetchedDoc;
    });

    window.addEventListener('popstate', (event) => {
      const state = (event.state || {}) as Record<string, unknown>;
      if (state.nowSpa) window.location.reload();
    });
  }
</script>
</script>
</Base>

---
import Base from '../layouts/Base.astro';
import { education, experience, resumePdf, resumePdfUrl, skills, software } from '../data/resume';
import '../styles/resume.css';

const autoResponse = `Thanks for your interest in my experience. You can download my resume (2025 PDF) here: ${resumePdfUrl}\n\nThe interactive version includes additional trade assistant experience: https://jevangoldsmith.com/resume.html\n\nWarm regards,\nJevan Goldsmith`;
---
<Base
  title="Resume | Jevan Goldsmith"
  description="Jevan Goldsmith’s experience in finance, technology, sales, property development and hands-on trade assistance. Explore the resume or download the PDF."
  canonical="https://jevangoldsmith.com/resume.html"
  bodyClass="resume-page"
>
  <main class="resume-wrap">
    <header class="resume-heading">
      <div>
        <p class="resume-eyebrow">Experiences / Resume</p>
        <h1>Resume<span aria-hidden="true">.</span></h1>
        <p class="resume-intro">A little about me. The work I’ve done.<br />And what I’ve learned along the way.</p>
      </div>
      <div class="resume-actions">
        <a class="resume-button resume-button-primary" href={resumePdf} download="Jevan Goldsmith Resume 2025.pdf">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M5 16v5h14v-5" /></svg>
          Download PDF
        </a>
        <a class="resume-button" href="#email-resume">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" /></svg>
          Email me the PDF
        </a>
        <span class="resume-file-note">Original 2025 résumé · PDF · 618 KB</span>
      </div>
    </header>

    <div class="resume-document">
      <aside class="resume-sidebar" aria-label="Profile, contact details and skills">
        <div class="resume-profile">
          <img src="/images/resume/jevan-goldsmith.jpg" alt="Jevan Goldsmith" width="711" height="712" fetchpriority="high" />
          <h2>Jevan<br />Goldsmith</h2>
          <p>Curious by nature.<br />Practical by experience.</p>
        </div>

        <section class="resume-sidebar-section">
          <h3>Contact</h3>
          <address>
            <p>Hervey Bay, Queensland</p>
            <a href="tel:+61467043735">0467 043 735</a>
            <a href="mailto:jjgoldsmith43@gmail.com">jjgoldsmith43@gmail.com</a>
          </address>
          <div class="resume-socials">
            <a href="https://www.linkedin.com/in/jevan-goldsmith-7b885a185/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
            <a href="https://x.com/JevanGoldsmith" target="_blank" rel="noopener noreferrer">X ↗</a>
          </div>
        </section>

        <nav class="resume-sidebar-section resume-jump" aria-label="Resume sections">
          <h3>On this page</h3>
          <a href="#about-me">01 <span>About me</span></a>
          <a href="#work-experience">02 <span>Work experience</span></a>
          <a href="#education">03 <span>Education & fellowships</span></a>
          <a href="#beyond-work">04 <span>Beyond work</span></a>
        </nav>

        <section class="resume-sidebar-section">
          <h3>My skills</h3>
          <ul class="resume-skills">
            {skills.map(([name, level]) => <li><span>{name}</span><small>{level}</small></li>)}
          </ul>
        </section>

        <section class="resume-sidebar-section">
          <h3>Software</h3>
          <p class="resume-sidebar-caption">Proficient with</p>
          <ul class="resume-software">{software.map((name) => <li>{name}</li>)}</ul>
        </section>
      </aside>

      <div class="resume-content">
        <section id="about-me" class="resume-section">
          <p class="resume-section-number">01 / About me</p>
          <h2>Who am I?</h2>
          <p class="resume-about">I’m curious about a lot of things and always keen to learn. I work hard, ask questions, and care about showing up and delivering my best for the customer.</p>
          <p>My experience spans finance and IT, sales, property development, building a startup, and hands-on bathroom renovations.</p>
          <div class="resume-highlights" aria-label="Selected experience">
            <div><strong>50</strong><span>new clients<br />in four quarters</span></div>
            <div><strong>34</strong><span>childcare locations<br />analysed</span></div>
            <div><strong>~40</strong><span>bathroom renovations<br />assisted with</span></div>
          </div>
        </section>

        <section id="work-experience" class="resume-section">
          <p class="resume-section-number">02 / The work</p>
          <h2>Work experience</h2>
          <p class="resume-section-intro">Open a role to explore the details.</p>
          <div class="resume-controls" data-resume-controls hidden>
            <div class="resume-filters" role="group" aria-label="Filter work experience">
              <button type="button" data-resume-filter="all" aria-pressed="true">All work</button>
              <button type="button" data-resume-filter="business" aria-pressed="false">Business & technology</button>
              <button type="button" data-resume-filter="hands-on" aria-pressed="false">Hands-on</button>
            </div>
            <button type="button" class="resume-expand" data-resume-expand>Expand all</button>
          </div>
          <p class="resume-count sr-only" data-resume-count role="status" aria-live="polite"></p>
          <div class="resume-timeline">
            {experience.map((job) => (
              <details class="resume-role" id={job.id} data-resume-category={job.category} open={job.open}>
                <summary>
                  <span class="resume-role-heading">
                    <span class="resume-period">{job.period}</span>
                    <h3>{job.role}</h3>
                    <span class="resume-company">{job.company}</span>
                    <span class="resume-context">{job.context}</span>
                    <span class="resume-role-summary">{job.summary}</span>
                  </span>
                  <span class="resume-disclosure" aria-hidden="true">+</span>
                </summary>
                <div class="resume-role-detail">
                  <ul>{job.highlights.map((highlight) => <li>{highlight}</li>)}</ul>
                </div>
              </details>
            ))}
          </div>
          <p class="resume-source-note">Experience reflects my December 2025 résumé, with trade assistant experience added from my accompanying email. Durations and bathroom totals are approximate.</p>
        </section>

        <section id="education" class="resume-section">
          <p class="resume-section-number">03 / Always learning</p>
          <h2>Education & fellowships</h2>
          <div class="resume-education">
            {education.map((item) => (
              <article>
                <p class="resume-period">{item.period}</p>
                <h3>{item.title}</h3>
                <p class="resume-company">{item.organisation}</p>
                <p>{item.detail}</p>
              </article>
            ))}
          </div>
        </section>

        <section id="beyond-work" class="resume-section">
          <p class="resume-section-number">04 / Beyond work</p>
          <h2>More than a job title.</h2>
          <p>I’m drawn to great films and music, especially films from the ’90s and music from the ’60s and ’90s. I also enjoy dirt bike riding, including on my KLX400R dual-sport.</p>
          <p>Reading is a big part of my life. I’m interested in philosophy, autobiographies and how other people have lived. By my December 2025 résumé, I’d read 141 books over the preceding two years, across a range of interests.</p>
          <div class="resume-interest-links"><a href="/books.html">Explore my bookshelf ↗</a><a href="/movies.html">Films I’ve watched ↗</a><a href="/adventures.html">Trips & adventures ↗</a></div>
        </section>

        <section id="email-resume" class="resume-email resume-section" aria-labelledby="resume-email-title">
          <p class="resume-section-number">Keep a copy</p>
          <h2 id="resume-email-title">My résumé, in your inbox.</h2>
          <p>Receive a download link to the original 2025 PDF, plus a link to this page with the additional trade experience.</p>
          <!-- Native POST is intentional: FormSubmit autoresponses require
               reCAPTCHA and do not work through its AJAX endpoint. -->
          <form action="https://formsubmit.co/hello@jevangoldsmith.com" method="POST" class="resume-email-form">
            <input type="hidden" name="_subject" value="Jevan Goldsmith — resume request" />
            <input type="hidden" name="_autoresponse" value={autoResponse} />
            <input type="hidden" name="_next" value="https://jevangoldsmith.com/resume-requested.html" />
            <input type="hidden" name="Resume" value={resumePdfUrl} />
            <input type="hidden" name="message" value="Please email me a download link to Jevan Goldsmith’s 2025 resume." />
            <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="resume-honeypot" aria-hidden="true" aria-label="Leave this field blank" />
            <label for="resume-email">Your email address</label>
            <div class="resume-email-input-row">
              <input id="resume-email" type="email" name="email" autocomplete="email" placeholder="you@example.com" required maxlength="254" aria-describedby="resume-email-note" />
              <button type="submit" class="resume-button resume-button-primary">Send me the link <span aria-hidden="true">↗</span></button>
            </div>
            <p id="resume-email-note" class="resume-form-note">Continue to FormSubmit’s spam check to send your request. Your email is shared with FormSubmit and Jevan for this request; it won’t subscribe you to a mailing list.</p>
          </form>
          <p class="resume-direct-link">Prefer to save it now? <a href={resumePdf} download="Jevan Goldsmith Resume 2025.pdf">Download the PDF directly ↓</a></p>
        </section>
      </div>
    </div>
  </main>
  <script>
    import '../scripts/resume';
  </script>
</Base>

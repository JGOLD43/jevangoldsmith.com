---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import OpenMovieCase from '../../components/OpenMovieCase.astro';
import { renderCommentary, renderNotes } from '../../lib/notes-render';
import { movieSchema } from '../../lib/seo';
import { slugify } from '../../lib/slug';

export async function getStaticPaths() {
  const movies = await getCollection('movies');
  const used = new Set<string>();
  return movies.map((entry: any) => {
    let slug = slugify(entry.data.title || '') || String(entry.id);
    if (used.has(slug)) slug = `${slug}-${entry.id}`;
    used.add(slug);
    return { params: { slug }, props: { entry } };
  });
}

const { entry } = Astro.props as { entry: any };
const m = entry.data;
const slug = slugify(m.title || '') || String(entry.id);
const canonical = `https://jevangoldsmith.com/movies/${slug}.html`;

const notesHtml = renderNotes(m.notes);
const commentaryHtml = renderCommentary(m.commentary);

const tmdbGenres = Array.isArray(m.tmdbGenres) ? m.tmdbGenres : [];
const runtime = Number(m.runtime) || 0;
const runtimeStr = runtime ? `${Math.floor(runtime / 60)}h ${runtime % 60}m` : '';
const timesWatched = Number(m.timesWatched) || 0;

const poster = m.poster || '';
const starCount = Number(m.starCount) || 0;
const ratingValue = starCount > 0 ? starCount : null;

const schema = movieSchema({
  canonical,
  title: m.title,
  year: m.year,
  poster: poster && poster.startsWith('http') ? poster : undefined,
  genre: tmdbGenres[0] || m.genre,
  runtimeMinutes: runtime || null,
  rating: ratingValue,
  review: m.review
});
---
<Base
  title={`${m.title}${m.year ? ` (${m.year})` : ''} - Movies - Jevan Goldsmith`}
  description={m.review || m.overview || `Notes and review for ${m.title}.`}
  canonical={canonical}
  bodyClass="nav-compact movie-case-reading"
  noFooter
  pageType="Article"
  ogImage={poster && poster.startsWith('http') ? poster : undefined}
  breadcrumbs={[
    { name: 'Home', url: 'https://jevangoldsmith.com/' },
    { name: 'Movies', url: 'https://jevangoldsmith.com/movies.html' },
    { name: m.title, url: canonical }
  ]}
  extraSchema={[schema]}
>
  {poster && (
    <Fragment slot="head">
      <link rel="preload" as="image" fetchpriority="high" href={poster} />
    </Fragment>
  )}
  <main class="detail-page detail-page--movie movie-case-page">
    <a href="/movies.html" class="detail-back">← Back to Movies</a>
    <OpenMovieCase title={m.title} poster={poster} subtitle={[m.year, runtimeStr].filter(Boolean).join(' · ')}>
      <header>
        <p class="detail-kicker">{[m.year, runtimeStr, m.genre === 'Uncategorized' ? '' : m.genre].filter(Boolean).join(' · ')}</p>
        <h1 class="detail-title">{m.title}</h1>
        {m.rating && <p class="detail-rating">{m.rating}{m.starCount && <span class="movie-case-rating-number">{m.starCount}/5</span>}</p>}
        {m.date && <p class="detail-meta-line">Watched {m.date}{timesWatched > 1 ? ` · ${timesWatched}× total` : ''}</p>}
      </header>
      <section class="movie-insert-section">
        <h2 class="detail-h2">Synopsis</h2>
        <p class="detail-prose">{m.overview || 'A synopsis has not been added yet.'}</p>
      </section>
      {m.review && (
        <section class="movie-insert-section">
          <h2 class="detail-h2">Quick Review</h2>
          <p class="detail-pullquote">{m.review}</p>
        </section>
      )}
      {notesHtml && (
        <section class="movie-insert-section">
          <h2 class="detail-h2">My Notes</h2>
          <div class="movie-insert-notes" set:html={notesHtml} />
        </section>
      )}
      {commentaryHtml && (
        <section class="movie-insert-section">
          <h2 class="detail-h2">Re-Watch Log</h2>
          <div class="movie-insert-notes" set:html={commentaryHtml} />
        </section>
      )}
      {tmdbGenres.length > 0 && <p class="movie-insert-genres">{tmdbGenres.join(' / ')}</p>}
      {m.link && <a class="movie-insert-link" href={m.link} target="_blank" rel="noopener noreferrer">View on Letterboxd ↗</a>}
    </OpenMovieCase>
  </main>
</Base>

<script>
  const params = new URLSearchParams(window.location.search);
  const back = document.querySelector<HTMLAnchorElement>('.detail-page--movie .detail-back');
  if (params.get('from') === 'disc-boxes' && back) {
    const returnParams = new URLSearchParams({ view: 'disc-boxes' });
    const movie = params.get('discMovie');
    if (movie) returnParams.set('discMovie', movie);
    const sort = params.get('discSort');
    if (sort === 'tiers' || sort === 'collection') returnParams.set('discSort', sort);
    back.href = `/movies.html?${returnParams}`;
    back.textContent = '← Back to Disc boxes';
  }
</script>

<style is:global>
  body.movie-case-reading {
    background: radial-gradient(ellipse at 50% 0%, #3b3830 0, #181a1b 42%, #101112 80%);
    background-attachment: fixed;
    background-color: #101112;
  }
  .movie-case-page.detail-page { width: 100%; max-width: 1108px; padding: 22px 24px 64px; }
  .movie-case-page .detail-back { color: #e3ddd1; font-size: .85rem; margin-bottom: 20px; }
  .movie-case-page .detail-back:hover { color: #fff; }
  .movie-case-page .movie-open-case { min-height: min(73vw, 736px); }
  .movie-case-page .detail-kicker { display: block; }
  .movie-case-page .movie-case-rating-number { margin-left: 10px; font-size: .75rem; }
  .movie-case-page .movie-insert-notes { color: #373128; font-size: .94rem; line-height: 1.7; overflow-wrap: anywhere; }
  .movie-case-page .movie-insert-notes p { color: inherit; }
  .movie-case-page .movie-insert-genres { margin: 2rem 0 1rem; color: #706552; font-size: .7rem; line-height: 1.6; }
  .movie-case-page .movie-insert-link { display: inline-block; font-size: .78rem; font-weight: 600; }
  @media (max-width: 640px) {
    .movie-case-page.detail-page { padding: 20px 16px 40px; }
    .movie-case-page .movie-open-case { view-transition-name: none; }
  }
</style>

    <script>
      import '../scripts/theme.ts';
      // Static Speculation Rules above handle prerender for supporting
      // browsers; this only wires the <link rel=prefetch> hover fallback for
      // browsers without Speculation Rules support.
      import '../scripts/nav-prefetch.ts';
    </script>
    {/* JSON-LD at end of <body>: ~4KB structured-data block was previously
        in <head> where it stalled the parser before reaching <body>.
        Crawlers (Google, Bing, ClaudeBot, etc.) read JSON-LD anywhere in
        the document. Saves ~30-50ms FCP under CPU throttle, no behavior
        change for SEO. */}
    {!noJsonLd && canonical && (
      <JsonLd
        canonical={canonical}
        title={title}
        description={description}
        pageType={pageType}
        image={ogImage}
        breadcrumbs={breadcrumbs}

---
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import pages from '../../../data/pages.json';
import quotes from '../../public/data/quotes.json';
import { bodyClassFor, currentPageFromUrl } from '../lib/chrome';
import { type BreadcrumbStep, DEFAULT_OG_IMAGE, type ExtraSchema, type PageType, SITE_NAME } from '../lib/seo';
import { nowMapThumbUrl } from '../lib/now-location';
import { inlineSprite } from '../lib/icon-sprite';

// Site-wide navbar — inlined here (was components/Nav.astro). Active marker:
//   - leaf nav-link active when current page matches its href (adventure-*
//     subpages roll up to adventures.html)
//   - section dropdown-trigger active when section ID matches (Explore, Taste, Experiences)
const _navFile = currentPageFromUrl(Astro.url.pathname);
const _activeHref = _navFile.startsWith('adventure-') ? 'adventures.html' : _navFile;
const _sectionByFile: Record<string, string> = {};
for (const p of (pages as Array<{ path?: string; section?: string }>) ?? []) {
  if (p.path) _sectionByFile[p.path] = p.section ?? '';
}
const _activeSection = _sectionByFile[_navFile] ?? '';
const _triggerByLabel: Record<string, string> = {
  Explore: 'explore',
  Taste: 'taste',
  Experiences: 'experience',
};
const _triggerFilesByLabel: Record<string, Set<string>> = {
  Explore: new Set(['adventures.html', 'free-resources.html']),
};
const _explicitTriggerLabel = Object.keys(_triggerFilesByLabel).find((label) =>
  _triggerFilesByLabel[label]?.has(_activeHref),
);
const _standaloneNavFiles = new Set(['index.html', 'now.html']);
const _isTriggerActive = (label: string) => {
  if (_standaloneNavFiles.has(_activeHref)) return false;
  return _explicitTriggerLabel
    ? label === _explicitTriggerLabel
    : _triggerByLabel[label] === _activeSection;
};
const _tickerQuotes = (quotes as { tickerQuotes?: string[] }).tickerQuotes ?? [];
const _ticker = _tickerQuotes.length >= 5
  ? (() => {
      const shuffled = [..._tickerQuotes].sort(() => Math.random() - 0.5).slice(0, 5);
      shuffled.push(shuffled[0]);
      return shuffled;
    })()
  : _tickerQuotes;

// FCP path: inline theme guard (~120B sync, prevents dark-mode FOUC) →
// chrome.css (~38KB render-blocking, priority high) → per-page slice
// (inline if <4KB, external otherwise).

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  bodyClass?: string;
  /** Pages like /meet replace the global navbar with their own header. */
  noChrome?: boolean;
  /** Hide the site footer (used by full-bleed pages like /adventures). */
  noFooter?: boolean;
  /** schema.org page type for JSON-LD. Defaults to "WebPage". */
  pageType?: PageType;
  /** Breadcrumb trail. Defaults to Home → current page. */
  breadcrumbs?: BreadcrumbStep[];
  /** Robots meta content. Defaults to public indexing. */
  robots?: string;
  /** Skip JSON-LD (e.g. for non-public or redirect-only pages). */
  noJsonLd?: boolean;
  /** Per-page schema.org @graph nodes. Currently used by adventure-[slug]. */
  extraSchema?: ExtraSchema[];
}

const _currentPage = currentPageFromUrl(Astro.url.pathname);
const {
  title,
  description = '',
  canonical = '',
  ogType = 'website',
  ogImage = DEFAULT_OG_IMAGE,
  bodyClass = bodyClassFor(_currentPage),
  noChrome = false,
  noFooter = false,
  pageType = 'WebPage',
  breadcrumbs,
  robots = 'index, follow, max-image-preview:large',
  noJsonLd = false,
  extraSchema,
} = Astro.props as Props;

// Compact nav is the site-wide default — every page uses the smaller navbar.
// Merge it with whatever class the page already has (newsletter-page,
// meet-page, shelf-experience, etc.), de-duping so it's never repeated.
const _bodyClass = [...new Set(['nav-compact', ...bodyClass.split(/\s+/)].filter(Boolean))].join(' ');

const siteName = SITE_NAME;

// Speculation Rules (prerender/prefetch) emitted as a STATIC script so the
// build can hash it for the CSP. Previously injected at runtime by
// nav-prefetch.ts, which the CSP blocked once enforced. Supporting browsers use
// this; nav-prefetch.ts now only provides the <link rel=prefetch> fallback for
// browsers without Speculation Rules. (Dropped the saveData→conservative
// downgrade — minor; static content is required for a stable CSP hash.)
const speculationRules = {
  prerender: [
    {
      where: {
        and: [
          { href_matches: '/*.html' },
          { not: { href_matches: '/meet.html' } },
          { not: { href_matches: '/adventures.html' } },
          { not: { href_matches: '/search.html' } },
          { not: { href_matches: '/adventure-*.html' } },
        ],
      },
      eagerness: 'moderate',
    },
    { where: { href_matches: '/adventures.html' }, eagerness: 'conservative' },
  ],
  prefetch: [{ where: { href_matches: '/search.html' }, eagerness: 'moderate' }],
};

// Derive the page slug from the current URL for per-page preconnect hints
// (cross-origin image hosts on movies/videos).
const rawPath = Astro.url.pathname.replace(/^\/+|\/+$/g, '');
const seoSlug = rawPath === '' ? 'index' : rawPath.replace(/\.html$/, '').split('/').pop()!;

// Whether to fire a low-priority preload for the homepage portrait.
// Triggers on every non-home page so by the time the user taps the
// logo home-link the image is in the HTTP cache and renders
// instantly. fetchpriority="low" keeps it out of the way of the
// current page's LCP.
const _preloadHomePortrait = seoSlug !== 'index';

// Warm the /now satellite-tile cache from every page that isn't
// /now, so tap-to-now shows the image instantly. The tile is now a
// local same-origin asset (/images/now-map.jpg), so a plain preload
// is enough — no preconnect / crossorigin.
const _preloadNowMap = seoSlug !== 'now';
const _nowMapThumbUrl = _preloadNowMap ? nowMapThumbUrl() : '';

// per-page preconnect hints for cross-origin image hosts. One
// DNS+TLS round-trip up front beats paying it on every <img> request.
const preconnectOrigins: string[] = [];
if (seoSlug === 'movies') preconnectOrigins.push('https://a.ltrbxd.com');
if (seoSlug === 'videos') preconnectOrigins.push('https://i.ytimg.com');
// Note: /adventures used to preconnect to images.unsplash.com, but the
// build pipeline now self-hosts every Unsplash hero (assets:optimize +
// html-normalize rewrite to /images/generated/remote/...). The browser
// no longer crosses the third-party origin, so the hint was wasted.

// Cheap dns-prefetch on entry pages (index, search) so the user is
// already DNS-warm if they navigate into a collection page that uses
// these hosts. Doesn't open a TLS connection like preconnect — just
// resolves the name, ~10-30ms saved on the next nav.
const dnsPrefetchOrigins: string[] = [];
if (seoSlug === 'index' || seoSlug === 'search') {
  // unsplash + openlibrary are self-hosted post-build, so no DNS to prime.
  dnsPrefetchOrigins.push(
    'https://a.ltrbxd.com',
    'https://i.ytimg.com'
  );
}
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* FOUC guard: set data-theme synchronously before first paint so the
        page renders in the user's resolved theme. The full theme module
        (toggle button, system-pref listener) still runs at end of body —
        this only fixes the initial paint. ~120 bytes minified. */}
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('jg-theme')
            || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', t);
          const m = localStorage.getItem('jg-work-mode');
          document.documentElement.setAttribute('data-mode', m === 'personal' ? 'personal' : 'work');
        } catch (_) { /* private mode / SSR can't read storage */ }
      })();
    </script>
    {/* The native app starts the site with ?private-companion=1. Remember that
        flag only for this browser tab so the private app navigation survives
        normal same-origin page loads without appearing to public visitors. */}
    <script is:inline>
      (() => {
        try {
          const key = 'jg-private-companion';
          const appEntry = new URLSearchParams(location.search).get('private-companion') === '1';
          if (appEntry) sessionStorage.setItem(key, '1');
          if (appEntry || sessionStorage.getItem(key) === '1') {
            document.documentElement.setAttribute('data-private-companion', 'true');
          }
        } catch (_) { /* storage-disabled browsers simply keep the public UI */ }
      })();
    </script>
    <meta name="theme-color" content="#F5F3ED" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <link rel="stylesheet" href="/css/legacy-style.css" fetchpriority="high" />
    {/* Preload the single variable Chivo font (one file, weights 100-900)
        so the FOUT swap fires before first paint. Replaces the 4 prior
        static-weight files (60KB total) with a single ~33KB variable
        file — net first-visit font bytes ~−27KB. */}
    <link rel="preload" href="/fonts/chivo/chivo-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    {_preloadNowMap && (
      <>
        <link rel="preload" as="image" href={_nowMapThumbUrl} fetchpriority="low" />
      </>
    )}
    {_preloadHomePortrait && (
      <>
        <link
          rel="preload"
          as="image"
          type="image/avif"
          href="/images/generated/profile/profile-520.avif"
          imagesrcset="/images/generated/profile/profile-360.avif 360w, /images/generated/profile/profile-520.avif 520w, /images/generated/profile/profile-720.avif 720w, /images/generated/profile/profile-960.avif 960w"
          imagesizes="(max-width: 768px) 82vw, 42vw"
          fetchpriority="low"
        />
        <link
          rel="preload"
          as="image"
          type="image/jpeg"
          href="/images/generated/profile/profile-520.jpg"
          imagesrcset="/images/generated/profile/profile-360.jpg 360w, /images/generated/profile/profile-520.jpg 520w, /images/generated/profile/profile-720.jpg 720w, /images/generated/profile/profile-960.jpg 960w"
          imagesizes="(max-width: 768px) 82vw, 42vw"
          fetchpriority="low"
        />
      </>
    )}
    {preconnectOrigins.map((origin) => (
      <link rel="preconnect" href={origin} crossorigin />
    ))}
    {dnsPrefetchOrigins.map((origin) => (
      <link rel="dns-prefetch" href={origin} />
    ))}
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
    {description && <meta name="description" content={description} />}
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" href="/rss.xml" title={`${SITE_NAME} — RSS Feed`} />
    <link rel="alternate" type="application/json" href="/api/v1/index.json" title="Agent API index" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Agent instructions" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
    <style is:inline>
      /* Restructured site footer — overrides the legacy .footer rules
         so the same chrome ships on every page. */
      /* Light theme (default): cream bg with dark text, mirroring the
         rest of the light-mode page. Dark theme overrides below flip
         to the original near-black with light text. */
      .site-footer {
        color: var(--text-color);
        background: var(--background);
        border-top: 1px solid rgba(0,0,0,0.08);
        padding: 3rem 0 1.5rem;
      }
      .site-footer .container { max-width: var(--site-max-width, 1200px); margin: 0 auto; padding: 0 1.25rem; }
      .site-footer .site-footer-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr 1fr;
        gap: 2.5rem;
        padding-bottom: 2.75rem;
        margin-bottom: 1.75rem;
        border-bottom: 1px solid rgba(0,0,0,0.08);
        text-align: left;
      }
      .site-footer .site-footer-bottom { padding-top: 0.25rem; }
      .site-footer-brand-link {
        color: var(--text-color);
        font-family: Chivo, sans-serif;
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: 0.01em;
        text-decoration: none;
      }
      .site-footer-brand-link:hover { color: var(--secondary-color); }
      .site-footer-tagline {
        color: var(--text-light);
        font-size: 0.9rem;
        line-height: 1.55;
        margin: 0.5rem 0 1rem;
        max-width: 22rem;
      }
      .site-footer-social { display: flex; gap: 0.9rem; align-items: center; }
      .site-footer-social a {
        color: var(--text-light);
        display: inline-flex;
        transition: color 0.2s ease, transform 0.2s ease;
      }
      .site-footer-social a:hover { color: var(--secondary-color); transform: translateY(-2px); }
      .site-footer-social svg { width: 20px; height: 20px; fill: currentColor; }
      .site-footer-col-title {
        color: var(--text-color);
        font-family: Chivo, sans-serif;
        font-size: 0.72rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        font-weight: 700;
        margin: 0 0 0.9rem;
      }
      .site-footer-col ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
      .site-footer-col a {
        color: var(--text-light);
        font-size: 0.9rem;
        text-decoration: none;
        transition: color 0.2s ease;
      }
      .site-footer-col a:hover { color: var(--secondary-color); }
      .site-footer-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 1.25rem;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .site-footer-bottom p { color: var(--text-light); margin: 0; font-size: 0.8rem; }
      .site-footer-back {
        color: var(--text-light);
        font-size: 0.8rem;
        text-decoration: none;
        transition: color 0.2s ease;
      }
      .site-footer-back:hover { color: var(--secondary-color); }

      /* Full-screen Android app navigation. It is opt-in per browser tab and
         therefore never appears on the ordinary public website. */
      .private-companion-nav { display: none; }
      html[data-private-companion="true"] .private-companion-nav {
        --private-companion-height: calc(64px + env(safe-area-inset-bottom, 0px));
        z-index: 10002;
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        height: var(--private-companion-height);
        padding: 5px max(6px, env(safe-area-inset-right)) calc(4px + env(safe-area-inset-bottom, 0px)) max(6px, env(safe-area-inset-left));
        border-top: 1px solid #ded8cc;
        background: rgba(246, 242, 233, 0.97);
        box-shadow: 0 -2px 14px rgba(0, 0, 0, 0.12);
        backdrop-filter: blur(16px) saturate(150%);
      }
      html[data-private-companion="true"] .private-companion-nav a {
        min-width: 0;
        color: #667068;
        text-decoration: none;
        border-radius: 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1px;
        font-family: Chivo, -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: 0.61rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0.01em;
      }
      html[data-private-companion="true"] .private-companion-nav a[aria-current="page"] {
        color: #17211b;
        background: #fffdf8;
      }
      html[data-private-companion="true"] .private-companion-nav svg {
        width: 21px;
        height: 21px;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.9;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
      html[data-private-companion="true"] body {
        padding-bottom: calc(64px + env(safe-area-inset-bottom, 0px));
      }

      /* Dark theme: keep the original near-black footer chrome. */
      [data-theme="dark"] .site-footer {
        color: #fff;
        background: #0a0a0a;
        border-top-color: #222;
      }
      [data-theme="dark"] .site-footer .site-footer-grid { border-bottom-color: rgba(255,255,255,0.08); }
      [data-theme="dark"] .site-footer-brand-link { color: #fff; }
      [data-theme="dark"] .site-footer-tagline { color: rgba(255,255,255,0.55); }
      [data-theme="dark"] .site-footer-social a { color: rgba(255,255,255,0.7); }
      [data-theme="dark"] .site-footer-col-title { color: #fff; }
      [data-theme="dark"] .site-footer-col a { color: rgba(255,255,255,0.6); }
      [data-theme="dark"] .site-footer-bottom p { color: rgba(255,255,255,0.4); }
      [data-theme="dark"] .site-footer-back { color: rgba(255,255,255,0.55); }
      @media (max-width: 960px) {
        .site-footer .site-footer-grid { grid-template-columns: 1fr 1fr 1fr; }
        .site-footer .site-footer-brand { grid-column: 1 / -1; }
      }
      @media (max-width: 600px) {
        .site-footer .site-footer-grid { gap: 1.75rem 1rem; grid-template-columns: 1fr 1fr 1fr; }
        .site-footer-col-title { font-size: 0.65rem; letter-spacing: 0.14em; }
        .site-footer-col a { font-size: 0.85rem; }
        .site-footer-bottom { flex-direction: column; text-align: center; gap: 0.5rem; }
      }
      /* On collection pages (books, movies, etc.) the
         .collection-mobile-toggle, and on /adventures the
         .adventures-mobile-toggle, are position:fixed at the bottom of
         the viewport on mobile/tablet and cover ~56px of anything at
         the bottom — footer content, gallery images on detail pages,
         everything. Pad the body so the entire page has clearance for
         the toolbar instead of solving the overlap one element at a
         time. */
      @media (max-width: 768px) {
        body:has(.collection-mobile-toggle) {
          padding-bottom: calc(72px + env(safe-area-inset-bottom, 0px));
        }
      }
      @media (max-width: 968px) {
        body:has(.adventures-mobile-toggle) {
          padding-bottom: calc(72px + env(safe-area-inset-bottom, 0px));
        }
      }
    </style>
    {/* View Transitions (ClientRouter) was tried but Astro's swap-
        merge replaces page-bound <script> modules without re-firing
        their init logic. Per-page click handlers (people modal, books
        modal, etc) detach after the first transition. Speculation
        Rules in nav-prefetch.ts already prerender same-origin links on
        hover, which gives near-instant navigation without intercepting
        the page lifecycle, so we rely on that instead. */}
  </head>
  <body class={_bodyClass}>
    {/* Inlined icon sprite (hidden) so <use href="#icon-…"> resolves
        same-document and icons paint with the initial HTML — no external
        sprite.svg fetch that pops in after first paint on mobile. */}
    <Fragment set:html={inlineSprite} />
    {/* Skip-to-content link: first focusable element. Off-screen until
        focused via Tab. WCAG 2.4.1 (Bypass Blocks). */}
    <a href="#main" class="skip-to-content">Skip to content</a>
    <nav class="private-companion-nav" aria-label="Private Companion">
      <a href="/?private-companion=1" aria-current="page">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v9h13v-9"/></svg>
        <span>Site</span>
      </a>
      <a href="privatecompanionapp:///vault">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="7" width="16" height="13" rx="2"/><path d="M8 7V5a4 4 0 0 1 8 0v2"/><circle cx="12" cy="13" r="1.5"/></svg>
        <span>Vault</span>
      </a>
      <a href="privatecompanionapp:///website">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19.5V7l8-3 8 3v12.5"/><path d="M8 10h8M8 14h8M8 18h5"/></svg>
        <span>Studio</span>
      </a>
      <a href="privatecompanionapp:///ai">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/><circle cx="12" cy="12" r="5"/><path d="m5.6 5.6 2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/></svg>
        <span>AI</span>
      </a>
      <a href="privatecompanionapp:///settings">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1a1.7 1.7 0 0 0 1.9.3A1.7 1.7 0 0 0 10 3V2.8h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1Z"/></svg>
        <span>Settings</span>
      </a>
    </nav>
    {!noChrome && (
      <nav class="navbar">
        <div class="container">
          <div class="navbar-left">
            <a href="/index.html" class="logo">
              <picture class="logo-static">
                <source type="image/avif" srcset="/images/generated/logo/logo-nav-88.avif 1x, /images/generated/logo/logo-nav-176.avif 2x, /images/generated/logo/logo-nav-264.avif 3x, /images/generated/logo/logo-nav-352.avif 4x" />
                <img src="/images/generated/logo/logo-nav-176.png" srcset="/images/generated/logo/logo-nav-88.png 1x, /images/generated/logo/logo-nav-176.png 2x, /images/generated/logo/logo-nav-264.png 3x, /images/generated/logo/logo-nav-352.png 4x" alt="J.GOLDSMITH" class="logo-image" width="88" height="80" decoding="async" />
              </picture>
              <video class="logo-image logo-video" poster="/images/generated/logo/logo-nav-176.png" muted playsinline loop preload="none" data-webm-1x="/images/generated/video/logo-animated-176.webm" data-webm-2x="/images/generated/video/logo-animated-352.webm" data-webm-3x="/images/generated/video/logo-animated-528.webm" data-mp4-1x="/images/generated/video/logo-animated-176.mp4" data-mp4-2x="/images/generated/video/logo-animated-352.mp4" data-mp4-3x="/images/generated/video/logo-animated-528.mp4"></video>
            </a>
            <div class="wisdom-ticker">
              <div class="wisdom-ticker-track">
                {_ticker.map((phrase) => <a href="/quotes.html" class="wisdom-item">{phrase}</a>)}
              </div>
            </div>
          </div>
          <ul class="nav-links">
